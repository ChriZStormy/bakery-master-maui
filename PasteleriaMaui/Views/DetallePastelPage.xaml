<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PasteleriaMaui.ViewModels"
             x:Class="PasteleriaMaui.Views.DetallePastelPage"
             Title="Detalle del Pastel"
             BackgroundColor="#F7F4EF">

	<ScrollView>
		<VerticalStackLayout Padding="20,20,20,40" Spacing="20">

			<Border Stroke="#EAE4DB" 
                    StrokeThickness="1" 
                    BackgroundColor="#FAF8F5" 
                    HeightRequest="260"
                    Margin="0,5,0,0"
                    Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,6" Radius="15" Opacity="0.08" />
                </Border.Shadow>
                <Grid>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Label Text="🎂" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="Imagen no disponible" FontSize="14" TextColor="#A1887F" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <Image Source="{Binding PastelSeleccionado.FotoUrl}" 
                           Aspect="AspectFill" 
                           HeightRequest="260" />
                    <Border BackgroundColor="#CC8B5E34" 
                            StrokeThickness="0"
                            HeightRequest="36" 
                            WidthRequest="36" 
                            HorizontalOptions="End" 
                            VerticalOptions="Start" 
                            Margin="0,12,12,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label Text="⇱" 
                               FontSize="18" 
                               TextColor="White" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnExpandImageTapped" CommandParameter="{Binding PastelSeleccionado.FotoUrl}" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
			</Border>

			<Border Stroke="#EAE4DB" 
                    StrokeThickness="1" 
                    BackgroundColor="#FFFFFF" 
                    Padding="25">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.04" />
                </Border.Shadow>
				<VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="110, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="12">
                        <Label Grid.Row="0" Grid.Column="0" Text="Nombre:" FontSize="15" FontAttributes="Bold" TextColor="#5D4037" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding PastelSeleccionado.Nombre}" FontSize="15" TextColor="#3E2723" />
                        
                        <Label Grid.Row="1" Grid.Column="0" Text="Tamaño:" FontSize="15" FontAttributes="Bold" TextColor="#5D4037" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding PastelSeleccionado.Tamanio}" FontSize="15" TextColor="#3E2723" />
                        
                        <Label Grid.Row="2" Grid.Column="0" Text="Bizcocho:" FontSize="15" FontAttributes="Bold" TextColor="#5D4037" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding PastelSeleccionado.Bizcocho.Nombre}" FontSize="15" TextColor="#3E2723" />
                        
                        <Label Grid.Row="3" Grid.Column="0" Text="Relleno:" FontSize="15" FontAttributes="Bold" TextColor="#5D4037" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding PastelSeleccionado.Relleno.Nombre}" FontSize="15" TextColor="#3E2723" />

                        <Label Grid.Row="4" Grid.Column="0" Text="Glaseado:" FontSize="15" FontAttributes="Bold" TextColor="#5D4037" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding PastelSeleccionado.Glaseado.Nombre}" FontSize="15" TextColor="#3E2723" />

                        <Label Grid.Row="5" Grid.Column="0" Text="Categoría:" FontSize="15" FontAttributes="Bold" TextColor="#5D4037" />
                        <Label Grid.Row="5" Grid.Column="1" Text="{Binding PastelSeleccionado.Categoria.categoria}" FontSize="15" TextColor="#3E2723" />

                        <Label Grid.Row="6" Grid.Column="0" Text="Estado:" FontSize="15" FontAttributes="Bold" TextColor="#5D4037" IsVisible="{Binding IsAdmin}" />
                        <Label Grid.Row="6" Grid.Column="1" Text="{Binding EstadoPastelTexto}" FontSize="15" FontAttributes="Bold" TextColor="#8B5E34" IsVisible="{Binding IsAdmin}" />
                    </Grid>
				</VerticalStackLayout>
			</Border>

			<Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,0">
				<Button Grid.Column="0" 
                        Text="Editar" 
                        HeightRequest="52"
                        BackgroundColor="#FFFFFF" 
                        TextColor="#8B5E34"
                        CornerRadius="14"
                        FontAttributes="Bold"
                        FontSize="15"
                        Command="{Binding EditarCommand}"
                        IsVisible="{Binding IsAdmin}">
                    <Button.Shadow>
                        <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.08" />
                    </Button.Shadow>
                </Button>

				<Button Grid.Column="1" 
                        Text="{Binding BotonBajaTexto}" 
                        HeightRequest="52"
                        BackgroundColor="{Binding BotonBajaBgColor}" 
                        TextColor="{Binding BotonBajaTextColor}"
                        CornerRadius="14"
                        FontAttributes="Bold"
                        FontSize="15"
                        Command="{Binding EliminarCommand}"
                        IsVisible="{Binding IsAdmin}">
                    <Button.Shadow>
                        <Shadow Brush="#D32F2F" Offset="0,4" Radius="10" Opacity="0.05" />
                    </Button.Shadow>
                </Button>
			</Grid>

            <Button Text="Realizar Pedido" 
                    HeightRequest="54"
                    BackgroundColor="#8B5E34" 
                    TextColor="#FFFFFF"
                    CornerRadius="14"
                    FontAttributes="Bold"
                    FontSize="16"
                    Margin="0,5,0,0"
                    Command="{Binding RealizarPedidoCommand}"
                    IsVisible="{Binding IsCliente}">
                <Button.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,6" Opacity="0.2" Radius="10" />
                </Button.Shadow>
            </Button>
            
		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
