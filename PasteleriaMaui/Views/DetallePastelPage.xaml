<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasteleriaMaui.Views.DetallePastelPage"
             Title="Detalle del Pastel"
             BackgroundColor="#F7F4EF">

	<ScrollView>
		<VerticalStackLayout Padding="20,20,20,40" Spacing="25">

			<Border Stroke="#EAE4DB" 
                    StrokeThickness="1" 
                    BackgroundColor="#FFFFFF" 
                    Padding="25"
                    Margin="0,10,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,6" Radius="15" Opacity="0.06" />
                </Border.Shadow>
                
				<VerticalStackLayout Spacing="15">
					<Label Text="Información del Pastel" FontSize="22" FontAttributes="Bold" TextColor="#3E2723" Margin="0,0,0,10" HorizontalOptions="Center"/>
                    
                    <Border StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="Transparent" HorizontalOptions="Center" Margin="0,0,0,15">
                        <Image Source="{Binding PastelSeleccionado.FotoUrl}" 
                               HeightRequest="220" 
                               WidthRequest="220"
                               Aspect="AspectFill" />
                    </Border>
					
                    <Grid ColumnDefinitions="120, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="15">
                        <Label Grid.Row="0" Grid.Column="0" Text="Nombre:" FontSize="15" FontAttributes="Bold" TextColor="#5D4037" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding PastelSeleccionado.Nombre}" FontSize="15" TextColor="#3E2723" />
                        
                        <Label Grid.Row="1" Grid.Column="0" Text="Tamaño:" FontSize="15" FontAttributes="Bold" TextColor="#5D4037" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding PastelSeleccionado.Tamanio}" FontSize="15" TextColor="#3E2723" />
                        
                        <Label Grid.Row="2" Grid.Column="0" Text="Bizcocho:" FontSize="15" FontAttributes="Bold" TextColor="#5D4037" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding PastelSeleccionado.Bizcocho.Nombre}" FontSize="15" TextColor="#3E2723" />
                        
                        <Label Grid.Row="3" Grid.Column="0" Text="Relleno:" FontSize="15" FontAttributes="Bold" TextColor="#5D4037" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding PastelSeleccionado.Relleno.Nombre}" FontSize="15" TextColor="#3E2723" />

                        <Label Grid.Row="4" Grid.Column="0" Text="Glaseado:" FontSize="15" FontAttributes="Bold" TextColor="#5D4037" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding PastelSeleccionado.Glaseado.Nombre}" FontSize="15" TextColor="#3E2723" />

                        <Label Grid.Row="5" Grid.Column="0" Text="Categoría:" FontSize="15" FontAttributes="Bold" TextColor="#5D4037" />
                        <Label Grid.Row="5" Grid.Column="1" Text="{Binding PastelSeleccionado.Categoria.categoria}" FontSize="15" TextColor="#3E2723" />
                    </Grid>

				</VerticalStackLayout>
			</Border>

			<Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,0">
				<Button Grid.Column="0" 
                        Text="Editar" 
                        HeightRequest="52"
                        BackgroundColor="#FFFFFF" 
                        TextColor="#8B5E34"
                        CornerRadius="14"
                        FontAttributes="Bold"
                        FontSize="15"
                        Command="{Binding EditarCommand}"
                        IsVisible="{Binding IsAdmin}">
                    <Button.Shadow>
                        <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.08" />
                    </Button.Shadow>
                </Button>

				<Button Grid.Column="1" 
                        Text="Eliminar" 
                        HeightRequest="52"
                        BackgroundColor="#FFF0F0" 
                        TextColor="#D32F2F"
                        CornerRadius="14"
                        FontAttributes="Bold"
                        FontSize="15"
                        Command="{Binding EliminarCommand}"
                        IsVisible="{Binding IsAdmin}">
                    <Button.Shadow>
                        <Shadow Brush="#D32F2F" Offset="0,4" Radius="10" Opacity="0.05" />
                    </Button.Shadow>
                </Button>
			</Grid>

            <Button Text="Realizar Pedido" 
                    HeightRequest="54"
                    BackgroundColor="#8B5E34" 
                    TextColor="#FFFFFF"
                    CornerRadius="14"
                    FontAttributes="Bold"
                    FontSize="16"
                    Margin="0,5,0,0"
                    Command="{Binding RealizarPedidoCommand}"
                    IsVisible="{Binding IsCliente}">
                <Button.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,6" Opacity="0.2" Radius="10" />
                </Button.Shadow>
            </Button>
            
		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
