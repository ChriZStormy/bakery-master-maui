<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasteleriaMaui.Views.LoginPage"
             Title="Iniciar Sesión"
             BackgroundColor="#F7F4EF"> <!-- Fondo general beige claro -->

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">

            <Image Source="logo_pasteleria.png" 
                   HeightRequest="100" 
                   WidthRequest="100" 
                   HorizontalOptions="Center" />

            <Label Text="Dolce Vita" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   TextColor="#3E2723" 
                   HorizontalOptions="Center" 
                   Margin="0,20,0,5" />

            <Label Text="Bienvenido" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   TextColor="#3E2723" 
                   HorizontalOptions="Center" 
                   Margin="0,20,0,5" />
                   
            <Label Text="Ingresa a tu cuenta para continuar" 
                   FontSize="15" 
                   TextColor="#795548" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,25" />

            <!-- Tarjeta principal estilo iOS -->
            <Border Stroke="#EAE4DB" 
                    StrokeThickness="1" 
                    BackgroundColor="#FFFFFF" 
                    Padding="25,35" 
                    Margin="10,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,6" Radius="15" Opacity="0.06" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">
                    
                    <!-- Contenedor del Correo Electrónico -->
                    <Border Stroke="#D7CCC8" 
                            StrokeThickness="1" 
                            BackgroundColor="#FAF8F5" 
                            HeightRequest="52"
                            Padding="15,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <!-- ID intacto -->
                        <Entry x:Name="EmailEntry" 
                               Placeholder="Correo Electrónico" 
                               Keyboard="Email" 
                               BackgroundColor="Transparent" 
                               TextColor="#3E2723" 
                               PlaceholderColor="#A1887F"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Contenedor de la Contraseña y Botón de ver -->
                    <Border Stroke="#D7CCC8" 
                            StrokeThickness="1" 
                            BackgroundColor="#FAF8F5" 
                            HeightRequest="52"
                            Padding="15,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, Auto">
                            <!-- ID intacto -->
                            <Entry x:Name="PasswordEntry" 
                                   Placeholder="Contraseña" 
                                   IsPassword="True" 
                                   BackgroundColor="Transparent" 
                                   TextColor="#3E2723" 
                                   PlaceholderColor="#A1887F"
                                   VerticalOptions="Center"
                                   Grid.Column="0" />
                            <!-- Evento Clicked intacto -->
                            <Button Text="◉" 
                                    BackgroundColor="Transparent"
                                    TextColor="#8B5E34"
                                    FontSize="18"
                                    HorizontalOptions="End" 
                                    VerticalOptions="Center" 
                                    Clicked="OnTogglePasswordVisibilityClicked" 
                                    WidthRequest="45" 
                                    HeightRequest="45"
                                    Grid.Column="1" />
                        </Grid>
                    </Border>

                    <!-- Botón Principal: Evento Clicked intacto -->
                    <Button Text="Iniciar Sesión" 
                            HeightRequest="52" 
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            BackgroundColor="#8B5E34"
                            TextColor="#FFFFFF"
                            Margin="0,15,0,0"
                            Clicked="OnLoginClicked" />
                            
                </VerticalStackLayout>
            </Border>

            <!-- Botón Secundario: Evento Clicked intacto -->
            <Button Text="¿No tienes cuenta? Regístrate" 
                    BackgroundColor="Transparent" 
                    TextColor="#8B5E34" 
                    FontSize="14"
                    FontAttributes="Bold"
                    Margin="0,20,0,0"
                    Clicked="OnRegisterClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>