<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PasteleriaMaui.ViewModels"
             x:Class="PasteleriaMaui.Views.GestionUsuariosPage"
             Title="Gestión de Usuarios"
             BackgroundColor="#F7F4EF">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20,20,20,10" Spacing="6">
            <Label Text="Control de Usuarios y Roles" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   TextColor="#3E2723" 
                   HorizontalOptions="Center" />
            <Label Text="Administra roles, edición y estado activo/baja lógica de usuarios."
                   FontSize="13" 
                   TextColor="#8D6E63" 
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- User List -->
        <RefreshView Grid.Row="1" 
                     x:Name="UsuariosRefreshView" 
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding CargarUsuariosCommand}"
                     RefreshColor="#8B5E34">
            <CollectionView x:Name="UsuariosCollectionView" 
                            ItemsSource="{Binding Usuarios}" 
                            Margin="16,10,16,20">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="40" Spacing="10">
                        <Label Text="👥" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="No se encontraron usuarios o la red local no está autorizada." 
                               FontSize="14" 
                               TextColor="#8D6E63" 
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#EAE4DB" 
                                StrokeThickness="1" 
                                BackgroundColor="#FFFFFF" 
                                Padding="16" 
                                Margin="0,0,0,14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#8B5E34" Offset="0,3" Radius="8" Opacity="0.05" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="12">
                                <!-- Top Row: User Info & Status Badges -->
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto">
                                    <!-- User Info -->
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Nombre}" 
                                               FontSize="16" 
                                               FontAttributes="Bold" 
                                               TextColor="#3E2723" />
                                        <Label Text="{Binding Email}" 
                                               FontSize="13" 
                                               TextColor="#8D6E63" />
                                    </VerticalStackLayout>

                                    <!-- Badges: Estado y Rol -->
                                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Start">
                                        <!-- Status Badge (Baja Lógica / Activo) -->
                                        <Border StrokeThickness="0"
                                                BackgroundColor="{Binding StatusBadgeBgColor}"
                                                Padding="8,4"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding StatusText}" 
                                                   FontSize="11" 
                                                   FontAttributes="Bold" 
                                                   TextColor="{Binding StatusBadgeTextColor}" />
                                        </Border>

                                        <!-- Role Badge -->
                                        <Border StrokeThickness="0"
                                                BackgroundColor="{Binding RoleBadgeBgColor}"
                                                Padding="8,4"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Rol}" 
                                                   FontSize="11" 
                                                   FontAttributes="Bold" 
                                                   TextColor="{Binding RoleBadgeTextColor}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#F2EDE6" />

                                <!-- Actions Row -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <!-- Current User Notice -->
                                    <Label Grid.Column="0"
                                           Text="Tú (Sesión actual)" 
                                           IsVisible="{Binding IsCurrentUser}" 
                                           FontSize="12" 
                                           FontAttributes="Italic"
                                           TextColor="#A1887F" 
                                           VerticalOptions="Center" />

                                    <!-- Actions for other users -->
                                    <FlexLayout Grid.ColumnSpan="2" 
                                                IsVisible="{Binding CanEditRole}" 
                                                Wrap="Wrap" 
                                                JustifyContent="End" 
                                                AlignItems="Center">
                                        
                                        <!-- Botón Editar Información -->
                                        <Button Text="Editar" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:GestionUsuariosViewModel}}, Path=EditarUsuarioCommand}" 
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FAF8F5" 
                                                TextColor="#5D4037" 
                                                BorderColor="#D7CCC8"
                                                BorderWidth="1"
                                                FontSize="11" 
                                                FontAttributes="Bold" 
                                                CornerRadius="8" 
                                                HeightRequest="36" 
                                                Padding="10,0"
                                                Margin="0,0,6,4" />

                                        <!-- Botón Baja Lógica / Suspender / Reactivar -->
                                        <Button Text="{Binding ToggleStatusButtonText}" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:GestionUsuariosViewModel}}, Path=ToggleUserStatusCommand}" 
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{Binding ToggleStatusButtonBgColor}" 
                                                TextColor="{Binding ToggleStatusButtonTextColor}" 
                                                FontSize="11" 
                                                FontAttributes="Bold" 
                                                CornerRadius="8" 
                                                HeightRequest="36" 
                                                Padding="10,0"
                                                Margin="0,0,6,4" />

                                        <!-- Selector de Rol (Picker) -->
                                        <Border Stroke="#D7CCC8" 
                                                StrokeThickness="1" 
                                                BackgroundColor="#FAF8F5" 
                                                HeightRequest="36" 
                                                Padding="6,0"
                                                Margin="0,0,6,4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Picker Title="Rol" 
                                                    ItemsSource="{Binding RolesDisponibles}"
                                                    SelectedItem="{Binding RolSeleccionado}"
                                                    TextColor="#3E2723"
                                                    TitleColor="#8D6E63"
                                                    FontSize="11"
                                                    WidthRequest="105"
                                                    VerticalOptions="Center" />
                                        </Border>

                                        <!-- Botón Asignar Rol -->
                                        <Button Text="Asignar" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:GestionUsuariosViewModel}}, Path=AsignarRolCommand}" 
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#8B5E34" 
                                                TextColor="#FFFFFF" 
                                                FontSize="11" 
                                                FontAttributes="Bold" 
                                                CornerRadius="8" 
                                                HeightRequest="36" 
                                                Padding="12,0"
                                                Margin="0,0,0,4" />
                                    </FlexLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
