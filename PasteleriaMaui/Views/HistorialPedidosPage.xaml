<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PasteleriaMaui.ViewModels"
             xmlns:models="clr-namespace:PasteleriaMaui.Models"
             x:Class="PasteleriaMaui.Views.HistorialPedidosPage"
             x:DataType="viewmodels:HistorialPedidosViewModel"
             Title="{Binding TituloPagina}"
             BackgroundColor="#F7F4EF">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- BARRA SUPERIOR DE ACCIONES -->
        <Grid Grid.Row="0" ColumnDefinitions="*, *" Margin="20,15,20,0" ColumnSpacing="15">
            <!-- Botón Cliente: Nuevo Pedido Personalizado -->
            <Button Text="+ Realizar Pedido" 
                    Command="{Binding RealizarPedidoPersonalizadoCommand}"
                    BackgroundColor="#8B5E34" 
                    TextColor="#FFFFFF" 
                    CornerRadius="14" 
                    HeightRequest="50" 
                    FontAttributes="Bold" 
                    FontSize="15"
                    IsVisible="{Binding EsCliente}"
                    Grid.Column="0">
                <Button.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.15" />
                </Button.Shadow>
            </Button>

            <!-- Botón Admin: Ver Calendario -->
            <Button Text="📅 Ver Calendario" 
                    Command="{Binding VerCalendarioCommand}"
                    BackgroundColor="#FFFFFF" 
                    TextColor="#8B5E34" 
                    CornerRadius="14" 
                    HeightRequest="50" 
                    FontAttributes="Bold" 
                    FontSize="15"
                    IsVisible="{Binding EsAdmin}"
                    Grid.Column="0">
                <Button.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.08" />
                </Button.Shadow>
            </Button>

            <!-- Indicador de Comunicación en Tiempo Real (SignalR) -->
            <Border Grid.Column="1" 
                    BackgroundColor="#FAF8F5" 
                    Stroke="#EAE4DB" 
                    StrokeThickness="1" 
                    HeightRequest="38" 
                    Padding="12,0" 
                    HorizontalOptions="End" 
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="19" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="{Binding EstadoConexionTexto}" 
                           TextColor="{Binding EstadoConexionColor}" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- SUB-ENCABEZADO Y PESTAÑAS ADMINISTRATIVAS -->
        <VerticalStackLayout Grid.Row="1" Spacing="10" Margin="20,15,20,0">
            <!-- Leyenda para Cliente -->
            <Label Text="{Binding LeyendaTexto}" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="#3E2723" 
                   IsVisible="{Binding EsCliente}" />

            <!-- Pestañas Administrativas (Filtros en tiempo real) -->
            <VerticalStackLayout IsVisible="{Binding EsAdmin}" Spacing="10">
                <!-- Pestañas Principales por Estatus -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="En Proceso" 
                                Command="{Binding CambiarTabPrincipalCommand}" 
                                CommandParameter="En Proceso"
                                BackgroundColor="{Binding TabEnProcesoBg}" 
                                TextColor="{Binding TabEnProcesoText}" 
                                CornerRadius="20" 
                                HeightRequest="40" 
                                Padding="20,0" 
                                FontAttributes="Bold" />
                        <Button Text="Entregados" 
                                Command="{Binding CambiarTabPrincipalCommand}" 
                                CommandParameter="Entregados"
                                BackgroundColor="{Binding TabEntregadosBg}" 
                                TextColor="{Binding TabEntregadosText}" 
                                CornerRadius="20" 
                                HeightRequest="40" 
                                Padding="20,0" 
                                FontAttributes="Bold" />
                        <Button Text="Cancelados" 
                                Command="{Binding CambiarTabPrincipalCommand}" 
                                CommandParameter="Cancelados"
                                BackgroundColor="{Binding TabCanceladosBg}" 
                                TextColor="{Binding TabCanceladosText}" 
                                CornerRadius="20" 
                                HeightRequest="40" 
                                Padding="20,0" 
                                FontAttributes="Bold" />
                    </HorizontalStackLayout>
                </ScrollView>
                
                <!-- Sub-pestañas por Tipo -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Pasteles" 
                                Command="{Binding CambiarSubTabCommand}" 
                                CommandParameter="Pasteles"
                                BackgroundColor="{Binding SubTabPastelesBg}" 
                                TextColor="{Binding SubTabPastelesText}" 
                                CornerRadius="16" 
                                HeightRequest="32" 
                                FontSize="13" 
                                Padding="15,0" 
                                FontAttributes="Bold" />
                        <Button Text="Otros" 
                                Command="{Binding CambiarSubTabCommand}" 
                                CommandParameter="Otros"
                                BackgroundColor="{Binding SubTabOtrosBg}" 
                                TextColor="{Binding SubTabOtrosText}" 
                                CornerRadius="16" 
                                HeightRequest="32" 
                                FontSize="13" 
                                Padding="15,0" 
                                FontAttributes="Bold" />
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- REFRESHVIEW CON LA COLECCIÓN EN TIEMPO REAL -->
        <RefreshView Grid.Row="2" 
                     IsRefreshing="{Binding IsRefreshing}" 
                     Command="{Binding RecargarPedidosCommand}"
                     RefreshColor="#8B5E34"
                     Margin="20,15,20,0">
            <CollectionView ItemsSource="{Binding Pedidos}" 
                            SelectionMode="Single" 
                            SelectedItem="{Binding PedidoSeleccionado, Mode=TwoWay}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="0,50">
                        <Label Text="📦" FontSize="44" HorizontalOptions="Center" />
                        <Label Text="No se encontraron pedidos" FontSize="16" FontAttributes="Bold" TextColor="#8D6E63" HorizontalOptions="Center" />
                        <Label Text="Desliza hacia abajo para actualizar" FontSize="12" TextColor="#BCAAA4" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Pedido">
                        <Border Stroke="#EAE4DB" 
                                StrokeThickness="1" 
                                BackgroundColor="#FFFFFF" 
                                Padding="18"
                                Margin="0,0,0,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.06" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Pastel.Nombre, StringFormat='{0}'}" FontSize="17" FontAttributes="Bold" TextColor="#3E2723" />
                                <BoxView HeightRequest="1" Color="#F5F0E6" Margin="0,3" />
                                
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Fecha, StringFormat='Fecha: {0:dd/MM/yyyy}'}" FontSize="13" TextColor="#5D4037" />
                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding Usuario.Nombre, StringFormat='Cliente: {0}'}" FontSize="13" TextColor="#795548" />
                                    <Label Grid.Row="2" Grid.Column="0" Text="{Binding Cantidad, StringFormat='Cantidad: {0}'}" FontSize="13" TextColor="#795548" />
                                    <Label Grid.Row="3" Grid.Column="0" Text="{Binding Total, StringFormat='Total: {0:C2}'}" FontSize="13" FontAttributes="Bold" TextColor="#8B5E34" />
                                    
                                    <!-- Badge de Estatus Dinámico -->
                                    <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" BackgroundColor="#FFF8F5" Stroke="#FFCCBC" StrokeThickness="1" Padding="10,6" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Estatus}" FontSize="13" TextColor="#D84315" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
