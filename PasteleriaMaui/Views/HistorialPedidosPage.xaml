<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasteleriaMaui.Views.HistorialPedidosPage"
             Title="Mis Pedidos"
             BackgroundColor="#F7F4EF">

    <Grid RowDefinitions="Auto, Auto, *">
        <Grid Grid.Row="0" ColumnDefinitions="*, *" Margin="20,20,20,0" ColumnSpacing="15">
            <Button x:Name="BtnNuevoPedido" 
                    Text="+ Realizar Pedido" 
                    BackgroundColor="#8B5E34" 
                    TextColor="#FFFFFF" 
                    CornerRadius="14" 
                    HeightRequest="52" 
                    FontAttributes="Bold" 
                    FontSize="15"
                    Clicked="OnRealizarPedidoPersonalizadoClicked" 
                    Grid.Column="0">
                <Button.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.15" />
                </Button.Shadow>
            </Button>
            <Button x:Name="BtnCalendario" 
                    Text="📅 Ver Calendario" 
                    BackgroundColor="#FFFFFF" 
                    TextColor="#8B5E34" 
                    CornerRadius="14" 
                    HeightRequest="52" 
                    FontAttributes="Bold" 
                    FontSize="15"
                    Clicked="OnVerCalendarioClicked" 
                    Grid.Column="1" 
                    IsVisible="False">
                <Button.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.08" />
                </Button.Shadow>
            </Button>
        </Grid>
        
        <Label x:Name="LblLeyenda" Text="Pedidos que has realizado" FontSize="20" FontAttributes="Bold" TextColor="#3E2723" Margin="20,15,20,0" Grid.Row="1" />

        <!-- Tabs para Admin y Repostero (HU-07) -->
        <VerticalStackLayout x:Name="TabsContainer" IsVisible="False" Margin="20,10,20,0" Grid.Row="1" Spacing="8">
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="TabsStack" Spacing="10">
                    <Button x:Name="TabEnProceso" Text="Pendientes / Cocina" Clicked="OnMainTabClicked" BackgroundColor="#8B5E34" TextColor="#FFFFFF" CornerRadius="20" HeightRequest="38" Padding="18,0" FontAttributes="Bold" FontSize="13"/>
                    <Button x:Name="TabListos" Text="Listos para entrega" Clicked="OnMainTabClicked" BackgroundColor="#FAF8F5" TextColor="#795548" CornerRadius="20" HeightRequest="38" Padding="18,0" FontAttributes="Bold" FontSize="13"/>
                    <Button x:Name="TabEntregados" Text="Entregados" Clicked="OnMainTabClicked" BackgroundColor="#FAF8F5" TextColor="#795548" CornerRadius="20" HeightRequest="38" Padding="18,0" FontAttributes="Bold" FontSize="13"/>
                    <Button x:Name="TabCancelados" Text="Cancelados" Clicked="OnMainTabClicked" BackgroundColor="#FAF8F5" TextColor="#795548" CornerRadius="20" HeightRequest="38" Padding="18,0" FontAttributes="Bold" FontSize="13"/>
                    <Button x:Name="TabTodos" Text="Todos" Clicked="OnMainTabClicked" BackgroundColor="#FAF8F5" TextColor="#795548" CornerRadius="20" HeightRequest="38" Padding="18,0" FontAttributes="Bold" FontSize="13"/>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <RefreshView x:Name="RefrescarView" Refreshing="OnRefrescarViewRefreshing" Grid.Row="2" Margin="20,15,20,0">
            <CollectionView ItemsSource="{Binding Pedidos}" SelectionMode="Single" SelectionChanged="OnPedidoSelected">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,50,0,0">
                        <Label Text="📦" FontSize="45" HorizontalOptions="Center" />
                        <Label Text="No hay pedidos en esta vista." FontSize="16" FontAttributes="Bold" TextColor="#795548" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#EAE4DB" 
                                StrokeThickness="1" 
                                BackgroundColor="#FFFFFF" 
                                Padding="18"
                                Margin="0,0,0,15">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.06" />
                            </Border.Shadow>
                            
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="{Binding Pastel.Nombre, StringFormat='{0}'}" FontSize="17" FontAttributes="Bold" TextColor="#3E2723" VerticalOptions="Center" />
                                    
                                    <!-- Badge de Estatus de Fase de Producción (HU-07) -->
                                    <Border Grid.Column="1" 
                                            BackgroundColor="{Binding EstatusBadgeBg}" 
                                            StrokeThickness="1" 
                                            Padding="10,4" 
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Estatus}" FontSize="12" TextColor="{Binding EstatusBadgeColor}" FontAttributes="Bold" />
                                    </Border>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#F5F0E6" Margin="0,2" />

                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                    <!-- Fecha y Hora de Entrega requerida (HU-07 & HU-05) -->
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding FechaEntrega, StringFormat='⏰ Entrega requerida: {0:dd/MM/yyyy HH:mm}'}" FontSize="13" FontAttributes="Bold" TextColor="#3E2723" />
                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding Usuario.Nombre, StringFormat='Cliente: {0}'}" FontSize="13" TextColor="#5D4037" />
                                    <Label Grid.Row="2" Grid.Column="0" Text="{Binding Cantidad, StringFormat='Cantidad: {0} unidad(es)'}" FontSize="13" TextColor="#795548" />
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Fecha, StringFormat='Pedido: {0:dd/MM/yyyy}'}" FontSize="12" TextColor="#A1887F" />
                                </Grid>

                                <!-- Acciones Rápidas de Taller de Repostería (HU-07 Escenario 1) -->
                                <Button Text="👨‍🍳 Iniciar Elaboración ('En Preparación')" 
                                        BackgroundColor="#1976D2" 
                                        TextColor="#FFFFFF" 
                                        CornerRadius="10" 
                                        HeightRequest="40" 
                                        FontSize="13" 
                                        FontAttributes="Bold" 
                                        Margin="0,5,0,0"
                                        IsVisible="{Binding PuedeIniciarElaboracion}" 
                                        Clicked="OnIniciarElaboracionRapidaClicked" />

                                <Button Text="🎂 Finalizar Montaje ('Listo para entrega')" 
                                        BackgroundColor="#2E7D32" 
                                        TextColor="#FFFFFF" 
                                        CornerRadius="10" 
                                        HeightRequest="40" 
                                        FontSize="13" 
                                        FontAttributes="Bold" 
                                        Margin="0,5,0,0"
                                        IsVisible="{Binding PuedeFinalizarMontaje}" 
                                        Clicked="OnFinalizarMontajeRapidoClicked" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
