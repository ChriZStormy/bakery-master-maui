<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PasteleriaMaui.Models"
             x:Class="PasteleriaMaui.Views.ReporteEntregasPage"
             Title="Cumplimiento de Entregas"
             BackgroundColor="#F7F4EF">

    <ScrollView>
        <VerticalStackLayout Padding="20,15,20,35" Spacing="20">

            <!-- ENCABEZADO -->
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                <Label Text="⏱️ Cumplimiento de Entregas y Logística" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="#3E2723" 
                       HorizontalOptions="Center" />
                <Label Text="Evaluación de tiempos de despacho, puntualidad y cuellos de botella" 
                       FontSize="13" 
                       TextColor="#795548" 
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- TARJETA DE FILTROS POR PERÍODO -->
            <Border Stroke="#EAE4DB" 
                    StrokeThickness="1" 
                    BackgroundColor="#FFFFFF" 
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,4" Radius="12" Opacity="0.06" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Período de Evaluación" FontAttributes="Bold" FontSize="15" TextColor="#3E2723" />
                    
                    <!-- Botones rápidos -->
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Semanal (7 días)" HeightRequest="36" FontSize="12" CornerRadius="8" BackgroundColor="#FAF8F5" TextColor="#5D4037" BorderColor="#D7CCC8" BorderWidth="1" Clicked="OnFiltroSemanalClicked" />
                        <Button Text="Mensual (30 días)" HeightRequest="36" FontSize="12" CornerRadius="8" BackgroundColor="#FAF8F5" TextColor="#5D4037" BorderColor="#D7CCC8" BorderWidth="1" Clicked="OnFiltroMensualClicked" />
                        <Button Text="Todo el Historial" HeightRequest="36" FontSize="12" CornerRadius="8" BackgroundColor="#FAF8F5" TextColor="#5D4037" BorderColor="#D7CCC8" BorderWidth="1" Clicked="OnFiltroTodoClicked" />
                    </HorizontalStackLayout>

                    <!-- Selectores de Rango -->
                    <Grid ColumnDefinitions="1*, 1*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Fecha Inicio:" FontSize="12" FontAttributes="Bold" TextColor="#5D4037" />
                            <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="44" Padding="10,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <DatePicker x:Name="FiltroFechaInicio" Format="dd/MM/yyyy" TextColor="#3E2723" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Fecha Fin:" FontSize="12" FontAttributes="Bold" TextColor="#5D4037" />
                            <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="44" Padding="10,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <DatePicker x:Name="FiltroFechaFin" Format="dd/MM/yyyy" TextColor="#3E2723" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Button Text="🔍 Actualizar Reporte" 
                            HeightRequest="46" 
                            CornerRadius="12" 
                            BackgroundColor="#8B5E34" 
                            TextColor="#FFFFFF" 
                            FontAttributes="Bold" 
                            FontSize="14" 
                            Clicked="OnActualizarReporteClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- RESUMEN EJECUTIVO DE TIEMPOS DE ENTREGA -->
            <Grid ColumnDefinitions="1*, 1*, 1*" ColumnSpacing="10">
                <!-- Entregados a Tiempo -->
                <Border Grid.Column="0" Stroke="#C8E6C9" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                        <Label Text="✅ A Tiempo" FontSize="12" TextColor="#2E7D32" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label x:Name="LblTotalATiempo" Text="0" FontSize="20" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center" />
                        <Label x:Name="LblPctATiempo" Text="0% puntualidad" FontSize="10" TextColor="#388E3C" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Entregas Retrasadas -->
                <Border Grid.Column="1" Stroke="#FFCDD2" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                        <Label Text="⏰ Retrasados" FontSize="12" TextColor="#C62828" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label x:Name="LblTotalRetrasados" Text="0" FontSize="20" FontAttributes="Bold" TextColor="#C62828" HorizontalOptions="Center" />
                        <Label x:Name="LblPctRetrasados" Text="0% fuera de tiempo" FontSize="10" TextColor="#D32F2F" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Tiempo Promedio de Preparación -->
                <Border Grid.Column="2" Stroke="#EAE4DB" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                        <Label Text="⏱️ Promedio" FontSize="12" TextColor="#795548" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label x:Name="LblPromedioPreparacion" Text="0.0 hrs" FontSize="18" FontAttributes="Bold" TextColor="#3E2723" HorizontalOptions="Center" />
                        <Label Text="Tiempo prep." FontSize="10" TextColor="#8D6E63" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- BARRA DE PUNTUALIDAD LOGÍSTICA GLOBAL -->
            <Border Stroke="#EAE4DB" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Índice Global de Puntualidad Logística" FontSize="13" FontAttributes="Bold" TextColor="#3E2723" />
                        <Label x:Name="LblIndicePuntualidad" Grid.Column="1" Text="100%" FontSize="13" FontAttributes="Bold" TextColor="#2E7D32" />
                    </Grid>
                    <ProgressBar x:Name="ProgressPuntualidad" Progress="1.0" ProgressColor="#2E7D32" HeightRequest="10" />
                </VerticalStackLayout>
            </Border>

            <!-- BOTONES DE EXPORTACIÓN Y VISTA IMPRIMIBLE -->
            <Grid ColumnDefinitions="1*, 1*" ColumnSpacing="12">
                <Button Grid.Column="0" 
                        Text="📥 Exportar CSV" 
                        HeightRequest="46" 
                        CornerRadius="12" 
                        BackgroundColor="#FFFFFF" 
                        TextColor="#8B5E34" 
                        BorderColor="#8B5E34" 
                        BorderWidth="1.5" 
                        FontAttributes="Bold" 
                        FontSize="14" 
                        Clicked="OnExportarClicked" />
                
                <Button Grid.Column="1" 
                        Text="🖨️ Vista Imprimible" 
                        HeightRequest="46" 
                        CornerRadius="12" 
                        BackgroundColor="#8B5E34" 
                        TextColor="#FFFFFF" 
                        FontAttributes="Bold" 
                        FontSize="14" 
                        Clicked="OnVistaImprimibleClicked" />
            </Grid>

            <!-- DESGLOSE DETALLADO DE PEDIDOS DESPACHADOS -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Relación de Pedidos Despachados" FontSize="16" FontAttributes="Bold" TextColor="#3E2723" />
                
                <Label x:Name="LblSinPedidos" 
                       Text="No se encontraron pedidos en el rango de fechas seleccionado." 
                       TextColor="#8D6E63" 
                       FontSize="14" 
                       HorizontalOptions="Center" 
                       Margin="0,15,0,0" 
                       IsVisible="false" />

                <CollectionView x:Name="PedidosDespachadosList" ItemsSource="{Binding Pedidos}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Pedido">
                            <Border Stroke="#EAE4DB" 
                                    StrokeThickness="1" 
                                    BackgroundColor="#FFFFFF" 
                                    Padding="16" 
                                    Margin="0,0,0,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Pastel.Nombre, StringFormat='Orden #{0} - {1}'}" FontSize="15" FontAttributes="Bold" TextColor="#3E2723" />
                                            <Label Text="{Binding Usuario.Nombre, StringFormat='Cliente: {0}'}" FontSize="12" TextColor="#795548" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" BackgroundColor="#FAF8F5" Stroke="{Binding EstadoPuntualidadColor}" StrokeThickness="1" Padding="8,4" VerticalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding EstadoPuntualidadTexto}" FontSize="12" FontAttributes="Bold" TextColor="{Binding EstadoPuntualidadColor}" />
                                        </Border>
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="#F5F0E6" />

                                    <Grid ColumnDefinitions="1*, 1*" RowDefinitions="Auto, Auto" RowSpacing="4">
                                        <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                            <Label Text="📅 Prog:" FontSize="12" FontAttributes="Bold" TextColor="#5D4037" />
                                            <Label Text="{Binding FechaEntrega, StringFormat='{0:dd/MM/yyyy}'}" FontSize="12" TextColor="#3E2723" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4" HorizontalOptions="End">
                                            <Label Text="Modalidad:" FontSize="12" TextColor="#795548" />
                                            <Label Text="{Binding ModalidadEntrega, TargetNullValue='Sucursal'}" FontSize="12" TextColor="#3E2723" />
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                            <Label Text="⏱️ Prep:" FontSize="12" TextColor="#795548" />
                                            <Label Text="{Binding HorasPreparacion, StringFormat='{0} hrs'}" FontSize="12" TextColor="#3E2723" FontAttributes="Bold" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4" HorizontalOptions="End">
                                            <Label Text="Total:" FontSize="12" TextColor="#795548" />
                                            <Label Text="{Binding TotalFormateado}" FontSize="12" FontAttributes="Bold" TextColor="#8B5E34" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
