<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasteleriaMaui.Views.ReporteEntregasPage"
             Title="Reporte de Entregas">

	<ScrollView>
		<VerticalStackLayout Padding="30" Spacing="20">

			<Label Text="Pastel:" FontAttributes="Bold" FontSize="16" TextColor="#3E2723" />
			<Picker Title="Seleccionar Pastel...">
				<Picker.ItemsSource>
					<x:Array Type="{x:Type x:String}">
						<x:String>Pastel de Chocolate</x:String>
						<x:String>Pastel de Vainilla</x:String>
						<x:String>Pastel Red Velvet</x:String>
					</x:Array>
				</Picker.ItemsSource>
			</Picker>

			<BoxView HeightRequest="1" Color="#CCCCCC" Margin="0,10,0,10" />

			<Button Text="Ver Reporte" 
                    HeightRequest="50"
                    CornerRadius="8"
                    BackgroundColor="#A0522D"
                    TextColor="#FFF8DC"
                    FontAttributes="Bold"
                    FontSize="18"/>

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
