<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasteleriaMaui.Views.ReporteEntregasPage"
             Title="Reporte de Entregas"
             BackgroundColor="#F7F4EF">

	<ScrollView>
		<VerticalStackLayout Padding="20,20,20,40" Spacing="25">

            <Border Stroke="#EAE4DB" 
                    StrokeThickness="1" 
                    BackgroundColor="#FFFFFF" 
                    Padding="25">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,6" Radius="15" Opacity="0.06" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">
                    <Label Text="Filtrar Entregas" FontSize="20" FontAttributes="Bold" TextColor="#3E2723" Margin="0,0,0,5" HorizontalOptions="Center"/>
                    
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Pastel" FontSize="14" FontAttributes="Bold" TextColor="#5D4037" Margin="4,0,0,0" />
                        <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="52" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Picker Title="Seleccionar Pastel..." TextColor="#3E2723" TitleColor="#BCAAA4" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

			<Button Text="Ver Reporte" 
                    Margin="0,5,0,0"
                    HeightRequest="54"
                    CornerRadius="14"
                    BackgroundColor="#8B5E34"
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    FontSize="16">
                <Button.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,6" Radius="10" Opacity="0.2" />
                </Button.Shadow>
            </Button>

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
