<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasteleriaMaui.Views.PastelesReclamosPage"
             Title="Pasteles con Reclamos"
             BackgroundColor="#F7F4EF">

	<ScrollView>
		<VerticalStackLayout Padding="20,20,20,40" Spacing="15">

			<Border Stroke="#EAE4DB" 
                    StrokeThickness="1" 
                    BackgroundColor="#FFF0F0" 
                    Padding="20"
                    Margin="0,0,0,5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#D32F2F" Offset="0,4" Radius="10" Opacity="0.05" />
                </Border.Shadow>
				<VerticalStackLayout Spacing="5">
					<Label Text="Pastel de Chocolate" FontAttributes="Bold" FontSize="16" TextColor="#D32F2F"/>
					<Label Text="3 Reclamos reportados" FontSize="14" TextColor="#795548"/>
				</VerticalStackLayout>
			</Border>

			<Border Stroke="#EAE4DB" 
                    StrokeThickness="1" 
                    BackgroundColor="#FFF8E1" 
                    Padding="20"
                    Margin="0,0,0,5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#FBC02D" Offset="0,4" Radius="10" Opacity="0.05" />
                </Border.Shadow>
				<VerticalStackLayout Spacing="5">
					<Label Text="Pastel Red Velvet" FontAttributes="Bold" FontSize="16" TextColor="#F57F17"/>
					<Label Text="1 Reclamo reportado" FontSize="14" TextColor="#795548"/>
				</VerticalStackLayout>
			</Border>

			<BoxView HeightRequest="1" Color="#EAE4DB" Margin="0,15,0,15" />

			<Button Text="Ver Reporte" 
                    Margin="0,10,0,0"
                    HeightRequest="54"
                    CornerRadius="14"
                    BackgroundColor="#8B5E34"
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    FontSize="16">
                <Button.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,6" Radius="10" Opacity="0.2" />
                </Button.Shadow>
            </Button>

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
