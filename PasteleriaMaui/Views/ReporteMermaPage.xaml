<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasteleriaMaui.Views.ReporteMermaPage"
             Title="Control de Mermas"
             BackgroundColor="#F7F4EF">

    <Grid RowDefinitions="Auto, *">

        <!-- ENCABEZADO Y SELECTOR DE PESTAÑAS -->
        <VerticalStackLayout Grid.Row="0" Padding="20,15,20,10" Spacing="10" BackgroundColor="#F7F4EF">
            <Label x:Name="LabelTituloModulo" 
                   Text="Control de Mermas y Desperdicios" 
                   FontAttributes="Bold" 
                   FontSize="22" 
                   TextColor="#3E2723" 
                   HorizontalOptions="Center" />

            <!-- Selector de Pestañas para Admin / Repostero -->
            <Border x:Name="BarraTabs" 
                    Stroke="#E0D7CD" 
                    StrokeThickness="1" 
                    BackgroundColor="#FFFFFF" 
                    Padding="4" 
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="6">
                    <Button x:Name="TabBtnRegistro" 
                            Text="📝 Registrar Merma" 
                            HeightRequest="38" 
                            FontSize="13" 
                            FontAttributes="Bold" 
                            CornerRadius="8" 
                            BackgroundColor="#8B5E34" 
                            TextColor="#FFFFFF" 
                            Clicked="OnTabRegistroClicked" />
                    <Button x:Name="TabBtnAnalitico" 
                            Text="📊 Reporte Analítico" 
                            HeightRequest="38" 
                            FontSize="13" 
                            FontAttributes="Bold" 
                            CornerRadius="8" 
                            BackgroundColor="#FAF8F5" 
                            TextColor="#5D4037" 
                            Clicked="OnTabAnaliticoClicked" />
                    <Button x:Name="TabBtnHistorial" 
                            Text="📋 Historial" 
                            HeightRequest="38" 
                            FontSize="13" 
                            FontAttributes="Bold" 
                            CornerRadius="8" 
                            BackgroundColor="#FAF8F5" 
                            TextColor="#5D4037" 
                            Clicked="OnTabHistorialClicked" />
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- CONTENIDO PRINCIPAL SCROLLABLE -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,5,20,30" Spacing="20">

                <!-- ========================================== -->
                <!-- PESTAÑA 1: REGISTRO DE MERMA OPERATIVA     -->
                <!-- ========================================== -->
                <VerticalStackLayout x:Name="SeccionRegistro" Spacing="15" IsVisible="true">
                    <Border Stroke="#EAE4DB" 
                            StrokeThickness="1" 
                            BackgroundColor="#FFFFFF" 
                            Padding="22">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#8B5E34" Offset="0,4" Radius="12" Opacity="0.08" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="15">
                            <Label Text="Registro de Pérdida / Merma en Taller" 
                                   FontAttributes="Bold" 
                                   FontSize="17" 
                                   TextColor="#3E2723" 
                                   HorizontalOptions="Center" />

                            <!-- Tipo de Merma: Pastel o Insumo -->
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Tipo de Elemento Afectado" FontAttributes="Bold" FontSize="14" TextColor="#5D4037" Margin="4,0,0,0" />
                                <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="48" Padding="12,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Picker x:Name="PickerTipoElemento" 
                                            Title="Selecciona tipo de merma" 
                                            TextColor="#3E2723" 
                                            TitleColor="#BCAAA4" 
                                            VerticalOptions="Center"
                                            SelectedIndexChanged="OnTipoElementoChanged">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>Pastel Terminado</x:String>
                                                <x:String>Materia Prima / Insumo</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Selector de Pastel Terminado -->
                            <VerticalStackLayout x:Name="LayoutPastel" Spacing="6" IsVisible="true">
                                <Label Text="Pastel Afectado" FontAttributes="Bold" FontSize="14" TextColor="#5D4037" Margin="4,0,0,0" />
                                <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="48" Padding="12,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Picker x:Name="PickerPastel" 
                                            Title="Selecciona el pastel del catálogo..." 
                                            ItemDisplayBinding="{Binding Nombre}" 
                                            TextColor="#3E2723" 
                                            TitleColor="#BCAAA4" 
                                            VerticalOptions="Center"
                                            SelectedIndexChanged="OnPastelSeleccionadoChanged" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Selector de Insumo / Materia Prima -->
                            <VerticalStackLayout x:Name="LayoutInsumo" Spacing="6" IsVisible="false">
                                <Label Text="Insumo / Materia Prima Afectada" FontAttributes="Bold" FontSize="14" TextColor="#5D4037" Margin="4,0,0,0" />
                                <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="48" Padding="12,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Picker x:Name="PickerInsumo" 
                                            Title="Selecciona el insumo afectado..." 
                                            TextColor="#3E2723" 
                                            TitleColor="#BCAAA4" 
                                            VerticalOptions="Center"
                                            SelectedIndexChanged="OnInsumoSeleccionadoChanged">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>Harina de Trigo (Kg)</x:String>
                                                <x:String>Azúcar Estándar / Glass (Kg)</x:String>
                                                <x:String>Mantequilla sin Sal (Kg)</x:String>
                                                <x:String>Huevos (Piezas)</x:String>
                                                <x:String>Leche Entera (Litros)</x:String>
                                                <x:String>Crema para Batir / Chantilly (Litros)</x:String>
                                                <x:String>Chocolate de Cobertura (Kg)</x:String>
                                                <x:String>Frutos Rojos / Fresas frescas (Kg)</x:String>
                                                <x:String>Bizcocho Horneado Base (Pieza)</x:String>
                                                <x:String>Relleno Elaborado (Kg)</x:String>
                                                <x:String>Glaseado Elaborado (Kg)</x:String>
                                                <x:String>Otro Insumo no listado</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                </Border>

                                <!-- Entrada personalizada si es Otro Insumo -->
                                <Border x:Name="LayoutOtroInsumo" Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="44" Padding="12,0" IsVisible="false">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Entry x:Name="EntryOtroInsumo" Placeholder="Escribe el nombre del insumo..." TextColor="#3E2723" PlaceholderColor="#BCAAA4" VerticalOptions="Center"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Cantidad y Unidad de Medida -->
                            <Grid ColumnDefinitions="1.5*, 1*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Text="Cantidad o Peso" FontAttributes="Bold" FontSize="14" TextColor="#5D4037" Margin="4,0,0,0" />
                                    <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="48" Padding="12,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Entry x:Name="EntryCantidad" 
                                               Text="1" 
                                               Keyboard="Numeric" 
                                               TextColor="#3E2723" 
                                               Placeholder="Ej: 1 o 2.5" 
                                               PlaceholderColor="#BCAAA4" 
                                               VerticalOptions="Center"
                                               TextChanged="OnCantidadOElementoChanged" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="Unidad" FontAttributes="Bold" FontSize="14" TextColor="#5D4037" Margin="4,0,0,0" />
                                    <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="48" Padding="12,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Picker x:Name="PickerUnidad" 
                                                TextColor="#3E2723" 
                                                TitleColor="#BCAAA4" 
                                                VerticalOptions="Center">
                                            <Picker.ItemsSource>
                                                <x:Array Type="{x:Type x:String}">
                                                    <x:String>Piezas</x:String>
                                                    <x:String>Kg</x:String>
                                                    <x:String>Litros</x:String>
                                                    <x:String>Gramos</x:String>
                                                </x:Array>
                                            </Picker.ItemsSource>
                                        </Picker>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Causa de Merma (Lista Predefinida de Criterios de Aceptación) -->
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Causa de la Pérdida *" FontAttributes="Bold" FontSize="14" TextColor="#5D4037" Margin="4,0,0,0" />
                                <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="48" Padding="12,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Picker x:Name="PickerCausa" 
                                            Title="Selecciona el motivo de merma..." 
                                            TextColor="#3E2723" 
                                            TitleColor="#BCAAA4" 
                                            VerticalOptions="Center">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>Caducidad de insumo</x:String>
                                                <x:String>Error de horneado/quemado</x:String>
                                                <x:String>Daño durante decoración/transporte</x:String>
                                                <x:String>Otro</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Costo Monetario Estimado -->
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Costo Monetario Estimado ($ MXN)" FontAttributes="Bold" FontSize="14" TextColor="#5D4037" Margin="4,0,0,0" />
                                <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="48" Padding="12,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Entry x:Name="EntryCostoEstimado" 
                                           Text="0.00" 
                                           Keyboard="Numeric" 
                                           TextColor="#3E2723" 
                                           Placeholder="0.00" 
                                           PlaceholderColor="#BCAAA4" 
                                           VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Fecha del Incidente -->
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Fecha del Incidente" FontAttributes="Bold" FontSize="14" TextColor="#5D4037" Margin="4,0,0,0" />
                                <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="48" Padding="12,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <DatePicker x:Name="FechaMerma" Format="dd/MM/yyyy" TextColor="#3E2723" VerticalOptions="Center"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Observaciones Adicionales (Opcional) -->
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Observación Adicional (Opcional)" FontAttributes="Bold" FontSize="14" TextColor="#5D4037" Margin="4,0,0,0" />
                                <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" Padding="12,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Editor x:Name="DescripcionMerma" 
                                            Placeholder="Añade detalles sobre el incidente (ej. lote, horno, refrigerador)..." 
                                            HeightRequest="75" 
                                            AutoSize="TextChanges" 
                                            BackgroundColor="Transparent" 
                                            TextColor="#3E2723" 
                                            PlaceholderColor="#BCAAA4"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Botón Confirmar Registro -->
                            <Button Text="Confirmar y Guardar Registro de Merma" 
                                    Margin="0,8,0,0" 
                                    HeightRequest="52" 
                                    CornerRadius="14" 
                                    BackgroundColor="#8B5E34" 
                                    TextColor="#FFFFFF" 
                                    FontAttributes="Bold" 
                                    FontSize="15" 
                                    Clicked="OnGuardarClicked">
                                <Button.Shadow>
                                    <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.2" />
                                </Button.Shadow>
                            </Button>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>


                <!-- ========================================== -->
                <!-- PESTAÑA 2: REPORTE ANALÍTICO DE MERMAS     -->
                <!-- ========================================== -->
                <VerticalStackLayout x:Name="SeccionAnalitico" Spacing="18" IsVisible="false">
                    
                    <!-- Tarjeta de Filtros de Reporte -->
                    <Border Stroke="#EAE4DB" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="18">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Filtros del Reporte Analítico" FontAttributes="Bold" FontSize="16" TextColor="#3E2723" />
                            
                            <!-- Botones rápidos de período -->
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Semanal" HeightRequest="34" FontSize="12" CornerRadius="6" BackgroundColor="#FAF8F5" TextColor="#5D4037" BorderColor="#D7CCC8" BorderWidth="1" Clicked="OnFiltroSemanalClicked" />
                                <Button Text="Mensual" HeightRequest="34" FontSize="12" CornerRadius="6" BackgroundColor="#FAF8F5" TextColor="#5D4037" BorderColor="#D7CCC8" BorderWidth="1" Clicked="OnFiltroMensualClicked" />
                                <Button Text="Todo el Historial" HeightRequest="34" FontSize="12" CornerRadius="6" BackgroundColor="#FAF8F5" TextColor="#5D4037" BorderColor="#D7CCC8" BorderWidth="1" Clicked="OnFiltroTodoClicked" />
                            </HorizontalStackLayout>

                            <!-- Rango de Fechas -->
                            <Grid ColumnDefinitions="1*, 1*" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Desde:" FontSize="12" FontAttributes="Bold" TextColor="#5D4037" />
                                    <DatePicker x:Name="FiltroFechaInicio" Format="dd/MM/yyyy" TextColor="#3E2723" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Hasta:" FontSize="12" FontAttributes="Bold" TextColor="#5D4037" />
                                    <DatePicker x:Name="FiltroFechaFin" Format="dd/MM/yyyy" TextColor="#3E2723" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Filtro por Causa -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Filtrar por Causa:" FontSize="12" FontAttributes="Bold" TextColor="#5D4037" />
                                <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="42" Padding="10,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Picker x:Name="FiltroCausaPicker" TextColor="#3E2723" Title="Todas las causas" TitleColor="#BCAAA4" VerticalOptions="Center">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>Todas las causas</x:String>
                                                <x:String>Caducidad de insumo</x:String>
                                                <x:String>Error de horneado/quemado</x:String>
                                                <x:String>Daño durante decoración/transporte</x:String>
                                                <x:String>Otro</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Botón Aplicar Filtro -->
                            <Button Text="🔍 Aplicar Filtros" HeightRequest="44" CornerRadius="10" BackgroundColor="#8B5E34" TextColor="#FFFFFF" FontAttributes="Bold" Clicked="OnAplicarFiltrosClicked" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Tarjetas de Resumen Ejecutivo -->
                    <Grid ColumnDefinitions="1*, 1*, 1*" ColumnSpacing="10">
                        <!-- Total Pérdida en Cantidad -->
                        <Border Grid.Column="0" Stroke="#EAE4DB" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="📉 Cantidad" FontSize="12" TextColor="#795548" HorizontalOptions="Center" />
                                <Label x:Name="LabelResumenCantidad" Text="0 u" FontSize="18" FontAttributes="Bold" TextColor="#D32F2F" HorizontalOptions="Center" />
                                <Label Text="Total perdido" FontSize="10" TextColor="#8D6E63" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Costo Monetario Estimado -->
                        <Border Grid.Column="1" Stroke="#EAE4DB" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="💰 Costo Est." FontSize="12" TextColor="#795548" HorizontalOptions="Center" />
                                <Label x:Name="LabelResumenCosto" Text="$0.00" FontSize="18" FontAttributes="Bold" TextColor="#C62828" HorizontalOptions="Center" />
                                <Label Text="Pérdida monetaria" FontSize="10" TextColor="#8D6E63" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Total Incidentes -->
                        <Border Grid.Column="2" Stroke="#EAE4DB" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="⚠️ Incidentes" FontSize="12" TextColor="#795548" HorizontalOptions="Center" />
                                <Label x:Name="LabelResumenIncidentes" Text="0" FontSize="18" FontAttributes="Bold" TextColor="#3E2723" HorizontalOptions="Center" />
                                <Label Text="Registros" FontSize="10" TextColor="#8D6E63" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- GRÁFICA COMPARATIVA DE CAUSAS MÁS FRECUENTES -->
                    <Border Stroke="#EAE4DB" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="18">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="14">
                            <Label Text="📊 Gráfica Comparativa: Causas más Frecuentes" FontAttributes="Bold" FontSize="15" TextColor="#3E2723" />
                            
                            <!-- Barra Causa 1: Caducidad de insumo -->
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="Caducidad de insumo" FontSize="13" TextColor="#5D4037" />
                                    <Label x:Name="LblStatCaducidad" Grid.Column="1" Text="0 incidentes (0%)" FontSize="12" FontAttributes="Bold" TextColor="#E65100" />
                                </Grid>
                                <ProgressBar x:Name="ProgressCaducidad" Progress="0.0" ProgressColor="#E65100" HeightRequest="10" />
                            </VerticalStackLayout>

                            <!-- Barra Causa 2: Error de horneado/quemado -->
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="Error de horneado / quemado" FontSize="13" TextColor="#5D4037" />
                                    <Label x:Name="LblStatHorneado" Grid.Column="1" Text="0 incidentes (0%)" FontSize="12" FontAttributes="Bold" TextColor="#C62828" />
                                </Grid>
                                <ProgressBar x:Name="ProgressHorneado" Progress="0.0" ProgressColor="#C62828" HeightRequest="10" />
                            </VerticalStackLayout>

                            <!-- Barra Causa 3: Daño durante decoración/transporte -->
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="Daño durante decoración / transporte" FontSize="13" TextColor="#5D4037" />
                                    <Label x:Name="LblStatDanio" Grid.Column="1" Text="0 incidentes (0%)" FontSize="12" FontAttributes="Bold" TextColor="#AD1457" />
                                </Grid>
                                <ProgressBar x:Name="ProgressDanio" Progress="0.0" ProgressColor="#AD1457" HeightRequest="10" />
                            </VerticalStackLayout>

                            <!-- Barra Causa 4: Otro -->
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="Otro motivo" FontSize="13" TextColor="#5D4037" />
                                    <Label x:Name="LblStatOtro" Grid.Column="1" Text="0 incidentes (0%)" FontSize="12" FontAttributes="Bold" TextColor="#4E342E" />
                                </Grid>
                                <ProgressBar x:Name="ProgressOtro" Progress="0.0" ProgressColor="#4E342E" HeightRequest="10" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>


                <!-- ========================================== -->
                <!-- PESTAÑA 3 / LISTA DE REGISTROS DE MERMAS   -->
                <!-- ========================================== -->
                <VerticalStackLayout x:Name="SeccionHistorial" Spacing="12" IsVisible="false">
                    <Label Text="Historial y Detalle de Mermas" FontAttributes="Bold" FontSize="16" TextColor="#3E2723" />
                    
                    <Label x:Name="LblSinRegistros" 
                           Text="No se encontraron registros de mermas para los criterios seleccionados." 
                           TextColor="#8D6E63" 
                           FontSize="14" 
                           HorizontalOptions="Center" 
                           Margin="0,20,0,0" 
                           IsVisible="false" />

                    <CollectionView x:Name="MermasList" ItemsSource="{Binding Mermas}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="#EAE4DB" 
                                        StrokeThickness="1" 
                                        BackgroundColor="#FFFFFF" 
                                        Padding="16" 
                                        Margin="0,0,0,12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#8B5E34" Offset="0,3" Radius="8" Opacity="0.05" />
                                    </Border.Shadow>
                                    
                                    <VerticalStackLayout Spacing="8">
                                        <!-- Encabezado de elemento y costo -->
                                        <Grid ColumnDefinitions="*, Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding ElementoDisplay}" FontSize="16" FontAttributes="Bold" TextColor="#3E2723" />
                                                <Label Text="{Binding TipoElemento, StringFormat='Tipo: {0}'}" FontSize="12" TextColor="#8D6E63" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1" BackgroundColor="#FFEBEE" Stroke="#FFCDD2" StrokeThickness="1" Padding="8,4" VerticalOptions="Start">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding CostoDisplay}" FontSize="13" FontAttributes="Bold" TextColor="#C62828" />
                                            </Border>
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="#F5F0E6" />

                                        <!-- Detalles: Causa, Cantidad, Fecha y Usuario -->
                                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="6">
                                            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                                                <Label Text="Causa:" FontSize="13" FontAttributes="Bold" TextColor="#5D4037" />
                                                <Label Text="{Binding Causa}" FontSize="13" TextColor="#E65100" FontAttributes="Bold" />
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6" HorizontalOptions="End">
                                                <Label Text="Pérdida:" FontSize="13" FontAttributes="Bold" TextColor="#5D4037" />
                                                <Label Text="{Binding CantidadDisplay}" FontSize="13" TextColor="#3E2723" />
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                                                <Label Text="Fecha:" FontSize="12" TextColor="#8D6E63" />
                                                <Label Text="{Binding FechaDisplay}" FontSize="12" TextColor="#5D4037" />
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6" HorizontalOptions="End">
                                                <Label Text="Por:" FontSize="12" TextColor="#8D6E63" />
                                                <Label Text="{Binding Usuario.Nombre, TargetNullValue='Personal de Repostería'}" FontSize="12" TextColor="#5D4037" FontAttributes="Italic" />
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <!-- Observación / Descripción opcional -->
                                        <Label Text="{Binding Descripcion}" 
                                               FontSize="13" 
                                               TextColor="#4E342E" 
                                               Margin="0,4,0,0" 
                                               IsVisible="{Binding Descripcion, Converter={x:Null}}" />

                                        <!-- Acciones Administrativas si aplica -->
                                        <HorizontalStackLayout Spacing="10" Margin="0,8,0,0" IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=IsAdmin}">
                                            <Button Text="📞 Contactar" 
                                                    BackgroundColor="#FFFFFF" 
                                                    TextColor="#2E7D32" 
                                                    BorderColor="#2E7D32" 
                                                    BorderWidth="1" 
                                                    Clicked="OnContactarClicked" 
                                                    CommandParameter="{Binding .}" 
                                                    CornerRadius="10" 
                                                    HeightRequest="38" 
                                                    FontSize="13" 
                                                    FontAttributes="Bold" />
                                            <Button Text="✔️ Marcar Atendida" 
                                                    BackgroundColor="#1565C0" 
                                                    TextColor="#FFFFFF" 
                                                    Clicked="OnAtenderClicked" 
                                                    CommandParameter="{Binding .}" 
                                                    CornerRadius="10" 
                                                    HeightRequest="38" 
                                                    FontSize="13" 
                                                    FontAttributes="Bold" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
