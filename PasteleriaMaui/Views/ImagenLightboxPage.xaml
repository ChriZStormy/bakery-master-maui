<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasteleriaMaui.Views.ImagenLightboxPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1A000000">

    <Grid>
        <!-- Fondo translúcido beige oscuro -->
        <BoxView Color="#CC2A1F1A" />

        <!-- Contenido central -->
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Fill" Padding="15" Spacing="15">
            
            <!-- Imagen principal -->
            <Border Stroke="#EAE4DB" 
                    StrokeThickness="2" 
                    BackgroundColor="#FAF8F5" 
                    Padding="0"
                    HorizontalOptions="Fill"
                    MaximumHeightRequest="500">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,8" Radius="25" Opacity="0.3" />
                </Border.Shadow>
                <Grid>
                    <!-- Placeholder -->
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Label Text="🖼️" FontSize="50" HorizontalOptions="Center" />
                        <Label Text="Imagen no disponible" FontSize="15" TextColor="#BCAAA4" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <!-- Imagen real -->
                    <Image x:Name="ImagenCompleta" 
                           Aspect="AspectFit"
                           MaximumHeightRequest="480" />
                </Grid>
            </Border>

            <!-- Botón cerrar -->
            <Button Text="✕  Cerrar" 
                    BackgroundColor="#FFFFFF" 
                    TextColor="#8B5E34" 
                    FontAttributes="Bold" 
                    FontSize="16" 
                    CornerRadius="14" 
                    HeightRequest="52"
                    HorizontalOptions="Fill"
                    Clicked="OnCerrarClicked">
                <Button.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.15" />
                </Button.Shadow>
            </Button>
        </VerticalStackLayout>
    </Grid>

</ContentPage>
