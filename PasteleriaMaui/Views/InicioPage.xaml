<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasteleriaMaui.Views.InicioPage"
             Title="Inicio"
             BackgroundColor="#F7F4EF">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,40,20,20" Spacing="15" VerticalOptions="Center">

                <Label Text="Sistema de Pasteles" 
                       FontSize="30" 
                       FontAttributes="Bold" 
                       TextColor="#3E2723" 
                       HorizontalOptions="Center" 
                       Margin="0,0,0,20" />

                <!-- BOTÓN PRINCIPAL HU-03: ESTUDIO DE PERSONALIZACIÓN DE PASTELES -->
                <Button x:Name="BotonPersonalizar" 
                        Text="🎂 ¡Arma tu Pastel en Vivo! (Estudio Creativo)" 
                        HeightRequest="65" 
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        BackgroundColor="#8B5E34" 
                        TextColor="#FFFFFF"
                        Margin="0,0,0,10"
                        Clicked="OnPersonalizarClicked">
                    <Button.Shadow>
                        <Shadow Brush="#8B5E34" Offset="0,6" Radius="14" Opacity="0.25" />
                    </Button.Shadow>
                </Button>

                <Button x:Name="BotonGestiones" 
                        Text="Gestión de Pasteles" 
                        HeightRequest="60" 
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        BackgroundColor="#FFFFFF" 
                        TextColor="#3E2723"
                        Clicked="OnPastelesClicked">
                    <Button.Shadow>
                        <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.08" />
                    </Button.Shadow>
                </Button>

                <Button x:Name="BotonPedidos" 
                        Text="Pedidos" 
                        HeightRequest="60" 
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        BackgroundColor="#FFFFFF" 
                        TextColor="#3E2723"
                        Clicked="OnPedidosClicked">
                    <Button.Shadow>
                        <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.08" />
                    </Button.Shadow>
                </Button>

                <Button x:Name="BotonComandas" 
                        Text="👨‍🍳 Comanda de Cocina" 
                        HeightRequest="60" 
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        BackgroundColor="#FFFFFF" 
                        TextColor="#3E2723"
                        Clicked="OnComandasClicked">
                    <Button.Shadow>
                        <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.08" />
                    </Button.Shadow>
                </Button>

                <Button x:Name="BotonMermas" 
                        Text="Reportes de Mermas" 
                        HeightRequest="60" 
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        BackgroundColor="#FFFFFF" 
                        TextColor="#3E2723"
                        Clicked="OnReportesClicked">
                    <Button.Shadow>
                        <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.08" />
                    </Button.Shadow>
                </Button>

                <Button x:Name="BotonCatalogos" 
                        Text="Catálogos" 
                        HeightRequest="60" 
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        BackgroundColor="#FFFFFF" 
                        TextColor="#3E2723"
                        Clicked="OnCatalogosClicked">
                    <Button.Shadow>
                        <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.08" />
                    </Button.Shadow>
                </Button>

                <Button x:Name="BotonUsuarios" 
                        Text="Gestión de Usuarios" 
                        HeightRequest="60" 
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        BackgroundColor="#FFFFFF" 
                        TextColor="#3E2723"
                        Clicked="OnUsuariosClicked">
                    <Button.Shadow>
                        <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.08" />
                    </Button.Shadow>
                </Button>

                <Button x:Name="BotonSalir" 
                        Text="Cerrar Sesión" 
                        HeightRequest="60" 
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        BackgroundColor="#FFF0F0" 
                        TextColor="#D32F2F"
                        Margin="0,20,0,0"
                        Clicked="OnSalirClicked">
                    <Button.Shadow>
                        <Shadow Brush="#D32F2F" Offset="0,4" Radius="10" Opacity="0.05" />
                    </Button.Shadow>
                </Button>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>