<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PasteleriaMaui.ViewModels"
             x:Class="PasteleriaMaui.Views.ComprobantePedidoPage"
             x:DataType="viewmodels:ComprobantePedidoViewModel"
             Title="Comprobante de Orden"
             BackgroundColor="#F7F4EF">

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,40" Spacing="20">
            <!-- Encabezado de Éxito -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Border BackgroundColor="#E8F5E9" 
                        Stroke="#81C784" 
                        StrokeThickness="1.5" 
                        WidthRequest="64" 
                        HeightRequest="64" 
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="32" />
                    </Border.StrokeShape>
                    <Label Text="✓" 
                           FontSize="32" 
                           FontAttributes="Bold" 
                           TextColor="#2E7D32" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" />
                </Border>
                <Label Text="¡Orden Confirmada!" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="#3E2723" 
                       HorizontalOptions="Center" 
                       Margin="0,5,0,0" />
                <Label Text="Tu comprobante de pedido ha sido emitido" 
                       FontSize="13" 
                       TextColor="#795548" 
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- TICKET / COMPROBANTE CARD -->
            <Border Stroke="#EAE4DB" 
                    StrokeThickness="1" 
                    BackgroundColor="#FFFFFF" 
                    Padding="22" 
                    Margin="0,5,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,6" Radius="15" Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <!-- Folio y Estatus Header -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="FOLIO DE ORDEN" FontSize="11" FontAttributes="Bold" TextColor="#A1887F" CharacterSpacing="1" />
                            <Label Text="{Binding FolioFormateado}" FontSize="18" FontAttributes="Bold" TextColor="#8B5E34" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="#FFF3E0" Stroke="#FFE0B2" StrokeThickness="1" Padding="12,5">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="{Binding Estatus}" FontSize="12" FontAttributes="Bold" TextColor="#E65100" />
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#EAE4DB" Margin="0,4" />

                    <!-- Información de Programación -->
                    <Label Text="📅 Programación de Entrega" FontSize="15" FontAttributes="Bold" TextColor="#3E2723" />
                    
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="10" ColumnSpacing="12">
                        <!-- Fecha -->
                        <Label Grid.Row="0" Grid.Column="0" Text="Fecha:" FontSize="13" FontAttributes="Bold" TextColor="#5D4037" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding FechaEntregaFormateada}" FontSize="13" TextColor="#3E2723" />

                        <!-- Hora -->
                        <Label Grid.Row="1" Grid.Column="0" Text="Hora:" FontSize="13" FontAttributes="Bold" TextColor="#5D4037" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding HoraFormateada}" FontSize="13" FontAttributes="Bold" TextColor="#8B5E34" />

                        <!-- Modalidad -->
                        <Label Grid.Row="2" Grid.Column="0" Text="Modalidad:" FontSize="13" FontAttributes="Bold" TextColor="#5D4037" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Modalidad}" FontSize="13" TextColor="#3E2723" />
                    </Grid>

                    <!-- Dirección de entrega -->
                    <Border BackgroundColor="#FAF8F5" Stroke="#E0D7CD" StrokeThickness="1" Padding="12" Margin="0,4,0,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="3">
                            <Label Text="📍 Destino / Punto de Entrega" FontSize="11" FontAttributes="Bold" TextColor="#8D6E63" />
                            <Label Text="{Binding Direccion}" FontSize="13" TextColor="#3E2723" />
                        </VerticalStackLayout>
                    </Border>

                    <BoxView HeightRequest="1" Color="#EAE4DB" Margin="0,4" />

                    <!-- Detalle del Producto -->
                    <Label Text="🍰 Producto Ordenado" FontSize="15" FontAttributes="Bold" TextColor="#3E2723" />
                    
                    <Grid ColumnDefinitions="70,*" ColumnSpacing="14" VerticalOptions="Center">
                        <Border Grid.Column="0" Stroke="#EAE4DB" StrokeThickness="1" BackgroundColor="#FAF8F5" WidthRequest="70" HeightRequest="70">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Image Source="{Binding FotoPastel}" Aspect="AspectFit" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding NombrePastel}" FontSize="15" FontAttributes="Bold" TextColor="#3E2723" />
                            <Label Text="{Binding TamanioPastel, StringFormat='Tamaño: {0}'}" FontSize="12" TextColor="#795548" />
                            <Label Text="{Binding Cantidad, StringFormat='Cantidad: {0} unidad(es)'}" FontSize="12" FontAttributes="Bold" TextColor="#8B5E34" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#EAE4DB" Margin="0,4" />

                    <!-- Total a Pagar -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="TOTAL DE LA ORDEN" FontSize="11" FontAttributes="Bold" TextColor="#A1887F" CharacterSpacing="1" />
                            <Label Text="Impuestos y envío incluidos" FontSize="11" TextColor="#8D6E63" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding TotalFormateado}" FontSize="20" FontAttributes="Bold" TextColor="#2E7D32" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Botones de Acción -->
            <VerticalStackLayout Spacing="12" Margin="0,10,0,0">
                <Button Text="📋 Ver en Historial de Pedidos" 
                        Command="{Binding VerHistorialCommand}"
                        BackgroundColor="#8B5E34" 
                        TextColor="#FFFFFF" 
                        FontAttributes="Bold" 
                        CornerRadius="14" 
                        HeightRequest="52" 
                        FontSize="15">
                    <Button.Shadow>
                        <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.2" />
                    </Button.Shadow>
                </Button>

                <Button Text="🏠 Volver al Inicio" 
                        Command="{Binding VolverAlInicioCommand}"
                        BackgroundColor="#FFFFFF" 
                        TextColor="#5D4037" 
                        BorderColor="#D7CCC8" 
                        BorderWidth="1.5" 
                        FontAttributes="Bold" 
                        CornerRadius="14" 
                        HeightRequest="50" 
                        FontSize="14" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
