<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasteleriaMaui.Views.DetallePedidoPage"
             Title="Detalle del Pedido"
             BackgroundColor="#F7F4EF">

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,40" Spacing="20">
            <Border Stroke="#EAE4DB" 
                    StrokeThickness="1" 
                    BackgroundColor="#FFFFFF" 
                    Padding="25"
                    Margin="0,10,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,6" Radius="15" Opacity="0.06" />
                </Border.Shadow>
                
                <VerticalStackLayout Spacing="12">
                    <Label Text="Fase de Producción" FontSize="20" FontAttributes="Bold" TextColor="#3E2723" Margin="0,0,0,5" HorizontalOptions="Center"/>
                    
                    <!-- Barra Gráfica de Avance de Producción (HU-07 & HU-05) -->
                    <Border Stroke="#EAE4DB" StrokeThickness="1" BackgroundColor="#FAF8F5" Padding="15" Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                <!-- Paso 1 -->
                                <Border Grid.Column="0" HeightRequest="6" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="3" />
                                    </Border.StrokeShape>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BackgroundColor" Value="#E0D7CD" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Fase1Completada}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#8B5E34" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <!-- Paso 2 -->
                                <Border Grid.Column="1" HeightRequest="6" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="3" />
                                    </Border.StrokeShape>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BackgroundColor" Value="#E0D7CD" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Fase2Completada}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#1976D2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <!-- Paso 3 -->
                                <Border Grid.Column="2" HeightRequest="6" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="3" />
                                    </Border.StrokeShape>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BackgroundColor" Value="#E0D7CD" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Fase3Completada}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#2E7D32" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <!-- Paso 4 -->
                                <Border Grid.Column="3" HeightRequest="6" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="3" />
                                    </Border.StrokeShape>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BackgroundColor" Value="#E0D7CD" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Fase4Completada}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#388E3C" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="2">
                                <Label Grid.Column="0" Text="1. Recibido" FontSize="11" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#8B5E34" />
                                <Label Grid.Column="1" Text="2. En Preparación" FontSize="11" HorizontalOptions="Center" FontAttributes="Bold">
                                    <Label.Style>
                                        <Style TargetType="Label">
                                            <Setter Property="TextColor" Value="#BCAAA4" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Fase2Completada}" Value="True">
                                                    <Setter Property="TextColor" Value="#1976D2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>
                                <Label Grid.Column="2" Text="3. Listo Entrega" FontSize="11" HorizontalOptions="Center" FontAttributes="Bold">
                                    <Label.Style>
                                        <Style TargetType="Label">
                                            <Setter Property="TextColor" Value="#BCAAA4" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Fase3Completada}" Value="True">
                                                    <Setter Property="TextColor" Value="#2E7D32" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>
                                <Label Grid.Column="3" Text="4. Entregado" FontSize="11" HorizontalOptions="Center" FontAttributes="Bold">
                                    <Label.Style>
                                        <Style TargetType="Label">
                                            <Setter Property="TextColor" Value="#BCAAA4" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Fase4Completada}" Value="True">
                                                    <Setter Property="TextColor" Value="#388E3C" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Información del Pedido" FontSize="18" FontAttributes="Bold" TextColor="#3E2723" Margin="0,5,0,5" />
                    
                    <Label Text="{Binding Pedido.Id, StringFormat='Folio: #{0}'}" FontSize="15" FontAttributes="Bold" TextColor="#8B5E34" />
                    <Label Text="{Binding Pedido.Fecha, StringFormat='Fecha de creación: {0:dd/MM/yyyy HH:mm}'}" FontSize="15" TextColor="#5D4037" />
                    <Label Text="{Binding Pedido.FechaEntrega, StringFormat='⏰ Entrega Requerida: {0:dd/MM/yyyy HH:mm}'}" FontSize="15" FontAttributes="Bold" TextColor="#3E2723" />
                    <Label Text="{Binding Pedido.Estatus, StringFormat='Estatus Actual: {0}'}" FontSize="15" FontAttributes="Bold" TextColor="#D84315" />
                    <Label Text="{Binding Pedido.Cantidad, StringFormat='Cantidad Solicitada: {0} unidad(es)'}" FontSize="15" TextColor="#5D4037" />
                    <Label Text="{Binding MontoTotal, StringFormat='Monto Pagado: ${0:N2} MXN'}" FontSize="15" FontAttributes="Bold" TextColor="#2E7D32" />
                    
                    <BoxView HeightRequest="1" Color="#EAE4DB" Margin="0,15" />
                    
                    <Label Text="Detalles del Producto" FontSize="18" FontAttributes="Bold" TextColor="#3E2723" Margin="0,0,0,5" />
                    <Label Text="{Binding Pedido.Pastel.Nombre, StringFormat='Pastel: {0}'}" FontSize="15" FontAttributes="Bold" TextColor="#5D4037" />
                    <Label Text="{Binding Pedido.Pastel.Tamanio, StringFormat='Tamaño: {0}'}" FontSize="15" TextColor="#795548" />
                    <Label Text="{Binding Pedido.Pastel.Bizcocho.Nombre, StringFormat='Bizcocho: {0}'}" FontSize="15" TextColor="#795548" />
                    <Label Text="{Binding Pedido.Pastel.Relleno.Nombre, StringFormat='Relleno: {0}'}" FontSize="15" TextColor="#795548" />
                    <Label Text="{Binding Pedido.Pastel.Glaseado.Nombre, StringFormat='Glaseado: {0}'}" FontSize="15" TextColor="#795548" />
                    <Label Text="{Binding Pedido.Pastel.Categoria.categoria, StringFormat='Categoría: {0}'}" FontSize="15" TextColor="#795548" />

                    <!-- Imagen de Referencia del Pastel -->
                    <Border Stroke="#EAE4DB" 
                            StrokeThickness="1" 
                            BackgroundColor="#FAF8F5" 
                            Padding="0"
                            HeightRequest="220"
                            Margin="0,15,0,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#8B5E34" Offset="0,3" Radius="8" Opacity="0.06" />
                        </Border.Shadow>
                        <Grid>
                            <!-- Placeholder (visible detrás si la imagen no carga) -->
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                                <Label Text="🖼️" FontSize="40" HorizontalOptions="Center" />
                                <Label Text="Imagen de referencia" FontSize="13" TextColor="#BCAAA4" HorizontalOptions="Center" />
                                <Label Text="no disponible" FontSize="12" TextColor="#D7CCC8" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <!-- Imagen real -->
                            <Image Source="{Binding Pedido.Pastel.FotoUrl}" 
                                   Aspect="AspectFill" />
                            <!-- Botón Expandir ⇱ -->
                            <Border BackgroundColor="#CC8B5E34" 
                                     StrokeThickness="0"
                                     HeightRequest="32" 
                                     WidthRequest="32" 
                                     HorizontalOptions="End" 
                                     VerticalOptions="Start" 
                                     Margin="0,8,8,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="⇱" 
                                       FontSize="16" 
                                       TextColor="White" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnExpandImageTapped" CommandParameter="{Binding Pedido.Pastel.FotoUrl}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <BoxView HeightRequest="1" Color="#EAE4DB" Margin="0,15" />
                    
                    <Label Text="Información del Cliente" FontSize="18" FontAttributes="Bold" TextColor="#3E2723" Margin="0,0,0,5" />
                    <Label Text="{Binding Pedido.Usuario.Nombre, StringFormat='Nombre: {0}'}" FontSize="15" TextColor="#5D4037" />
                    <Label Text="{Binding Pedido.Usuario.Email, StringFormat='Correo: {0}'}" FontSize="15" TextColor="#795548" />
                </VerticalStackLayout>
            </Border>

            <!-- Panel de Producción (HU-07) para Repostero y Admin -->
            <Border IsVisible="{Binding CanActualizarEstatus}"
                    Stroke="#EAE4DB" 
                    StrokeThickness="1" 
                    BackgroundColor="#FAF8F5" 
                    Padding="20"
                    Margin="0,5,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="15">
                    <Label Text="👨‍🍳 Taller de Repostería - Fase de Producción" FontSize="16" FontAttributes="Bold" TextColor="#3E2723" HorizontalOptions="Center"/>
                    
                    <!-- Botones de Acción Rápida para Repostero (HU-07) -->
                    <VerticalStackLayout Spacing="10">
                        <Button Text="🥣 Iniciar Elaboración ('En Preparación')" 
                                Command="{Binding IniciarElaboracionCommand}" 
                                BackgroundColor="#1976D2" 
                                TextColor="#FFFFFF" 
                                CornerRadius="12" 
                                HeightRequest="48"
                                FontAttributes="Bold"
                                FontSize="14" />

                        <Button Text="🎂 Finalizar Montaje ('Listo para entrega')" 
                                Command="{Binding FinalizarMontajeCommand}" 
                                BackgroundColor="#2E7D32" 
                                TextColor="#FFFFFF" 
                                CornerRadius="12" 
                                HeightRequest="48"
                                FontAttributes="Bold"
                                FontSize="14" />

                        <Button Text="🚚 Marcar como Entregado" 
                                Command="{Binding MarcarEntregadoCommand}" 
                                BackgroundColor="#5D4037" 
                                TextColor="#FFFFFF" 
                                CornerRadius="12" 
                                HeightRequest="44"
                                FontAttributes="Bold"
                                FontSize="13" 
                                IsVisible="{Binding IsAdmin}" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#EAE4DB" Margin="0,5" />
                    <Label Text="O seleccionar estatus manualmente:" FontSize="13" TextColor="#795548" HorizontalOptions="Center" />

                    <Border Stroke="#D7CCC8" 
                            StrokeThickness="1" 
                            BackgroundColor="#FFFFFF" 
                            HeightRequest="52"
                            Padding="15,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Picker x:Name="PickerEstatus" 
                                SelectedItem="{Binding NuevoEstatus}"
                                TextColor="#3E2723"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center">
                            <Picker.Items>
                                <x:String>Pendiente</x:String>
                                <x:String>En Preparación</x:String>
                                <x:String>Listo para entrega</x:String>
                                <x:String>Entregado</x:String>
                                <x:String>Cancelado</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>
                    
                    <Button Text="Guardar Estatus Manual" 
                            Command="{Binding ActualizarEstatusCommand}" 
                            BackgroundColor="#8B5E34" 
                            TextColor="#FFFFFF" 
                            CornerRadius="12" 
                            HeightRequest="48"
                            FontAttributes="Bold"
                            FontSize="14" />
                </VerticalStackLayout>
            </Border>
            
            <Button Text="Volver" 
                    Command="{Binding VolverCommand}" 
                    BackgroundColor="#FFFFFF" 
                    TextColor="#8B5E34" 
                    CornerRadius="14" 
                    HeightRequest="54" 
                    FontSize="16" 
                    FontAttributes="Bold"
                    Margin="0,5,0,0">
                <Button.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.08" />
                </Button.Shadow>
            </Button>
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
