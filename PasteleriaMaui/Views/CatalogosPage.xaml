<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PasteleriaMaui.ViewModels"
             x:Class="PasteleriaMaui.Views.CatalogosPage"
             Title="Catálogos">

	<ContentPage.BindingContext>
		<viewmodels:CatalogosViewModel />
	</ContentPage.BindingContext>

	<ContentPage.Background>
		<SolidColorBrush Color="#F5F7FA" />
	</ContentPage.Background>

	<Grid RowDefinitions="Auto, Auto, *">
		<VerticalStackLayout Padding="20" Spacing="15" Grid.Row="0">
			<Label Text="Administración de Catálogos" FontSize="22" FontAttributes="Bold" TextColor="#5C4033" Margin="0,0,0,10" HorizontalOptions="Center"/>
            <Grid ColumnDefinitions="*,*,*,*">
                <Button Grid.Column="0" Text="Cat" Command="{Binding SeleccionarTabCommand}" CommandParameter="Categorías" Margin="2" />
                <Button Grid.Column="1" Text="Biz" Command="{Binding SeleccionarTabCommand}" CommandParameter="Bizcochos" Margin="2" />
                <Button Grid.Column="2" Text="Rel" Command="{Binding SeleccionarTabCommand}" CommandParameter="Rellenos" Margin="2" />
                <Button Grid.Column="3" Text="Gla" Command="{Binding SeleccionarTabCommand}" CommandParameter="Glaseados" Margin="2" />
            </Grid>
            <Button Text="Agregar Nuevo Elemento" Command="{Binding AgregarElementoCommand}" BackgroundColor="#8B4513" TextColor="#FFF8DC" CornerRadius="8" HeightRequest="45" Margin="0,10,0,0" />
		</VerticalStackLayout>

        <Label Grid.Row="1" Text="{Binding TabActual}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#5C4033" Margin="0,10,0,10" />

		<CollectionView ItemsSource="{Binding Elementos}" Grid.Row="2" Margin="20,0,20,0">
			<CollectionView.ItemTemplate>
				<DataTemplate>
					<Border StrokeShape="RoundRectangle 12" Stroke="Transparent" BackgroundColor="#FFF8DC" Padding="20" Margin="0,0,0,15" Shadow="{Shadow Brush=Black, Offset='0,3', Opacity=0.1, Radius=4}">
						<Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
							<Label Grid.Column="0" Text="{Binding Id}" FontSize="16" FontAttributes="Bold" TextColor="#4E342E" Margin="0,0,15,0"/>
							<Label Grid.Column="1" Text="{Binding DisplayName}" FontSize="18" FontAttributes="Bold" TextColor="#5C4033" />
                            <Button Grid.Column="2" Text="Eliminar" BackgroundColor="#E53935" TextColor="#FFF8DC" CornerRadius="5" HeightRequest="35" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CatalogosViewModel}}, Path=EliminarElementoCommand}" CommandParameter="{Binding .}" />
						</Grid>
					</Border>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
	</Grid>

</ContentPage>
