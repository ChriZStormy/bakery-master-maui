<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasteleriaMaui.Views.RegistrarPedidoPage"
             Title="Registrar Pedido">

	<ScrollView>
		<VerticalStackLayout Padding="30" Spacing="15">

			<Label Text="Cantidad de Pasteles:" FontAttributes="Bold" FontSize="16" TextColor="#3E2723" />
			<Entry x:Name="EntryCantidad" Text="1" Keyboard="Numeric" ClearButtonVisibility="WhileEditing" />

			<Label Text="Fecha deseada de Entrega:" FontAttributes="Bold" FontSize="16" TextColor="#3E2723" Margin="0,10,0,0"/>
			<DatePicker x:Name="PickerFechaEntrega" Format="dd/MM/yyyy" />

			<Button Text="Confirmar Pedido" 
                    Margin="0,20,0,0" 
                    HeightRequest="50"
                    CornerRadius="8"
                    BackgroundColor="#8B4513"
                    TextColor="#FFF8DC"
                    FontAttributes="Bold"
                    FontSize="18"
                    Clicked="OnGuardarClicked"/>

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
