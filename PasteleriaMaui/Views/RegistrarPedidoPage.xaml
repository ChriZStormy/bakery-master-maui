<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PasteleriaMaui.ViewModels"
             x:Class="PasteleriaMaui.Views.RegistrarPedidoPage"
             x:DataType="viewmodels:RegistrarPedidoViewModel"
             Title="Programar Pedido"
             BackgroundColor="#F7F4EF">

    <ScrollView>
        <VerticalStackLayout Padding="20,15,20,40" Spacing="20">
            <!-- Título -->
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                <Label Text="📅 Programación y Orden" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="#3E2723" 
                       HorizontalOptions="Center"/>
                <Label Text="Define fecha, hora y modalidad de entrega para tu orden" 
                       FontSize="13" 
                       TextColor="#795548" 
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- TARJETA DEL PRODUCTO SELECCIONADO -->
            <Border Stroke="#EAE4DB" 
                    StrokeThickness="1" 
                    BackgroundColor="#FFFFFF" 
                    Padding="16" 
                    Margin="0,5,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.06" />
                </Border.Shadow>

                <Grid ColumnDefinitions="75,*" ColumnSpacing="15" VerticalOptions="Center">
                    <Border Grid.Column="0" Stroke="#EAE4DB" StrokeThickness="1" BackgroundColor="#FAF8F5" WidthRequest="75" HeightRequest="75">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Image Source="{Binding FotoPastel}" Aspect="AspectFit" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding NombrePastel}" FontSize="16" FontAttributes="Bold" TextColor="#3E2723" />
                        <Label Text="{Binding TamanioPastel, StringFormat='Tamaño: {0}'}" FontSize="13" TextColor="#795548" />
                        <Label Text="{Binding PrecioUnitarioFormateado, StringFormat='Precio unitario: {0}'}" FontSize="13" FontAttributes="Bold" TextColor="#8B5E34" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- FORMULARIO DE PROGRAMACIÓN Y LOGÍSTICA -->
            <Border Stroke="#EAE4DB" 
                    StrokeThickness="1" 
                    BackgroundColor="#FFFFFF" 
                    Padding="22" 
                    Margin="0,5,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,6" Radius="15" Opacity="0.06" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">
                    <!-- Cantidad de Pasteles -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Cantidad de Pasteles" FontSize="14" FontAttributes="Bold" TextColor="#5D4037" Margin="4,0,0,0" />
                        <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="50" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Entry Text="{Binding Cantidad, Mode=TwoWay}" 
                                   Keyboard="Numeric" 
                                   ClearButtonVisibility="WhileEditing" 
                                   BackgroundColor="Transparent" 
                                   TextColor="#3E2723" 
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Fecha y Hora de Entrega (Grid 2 Columnas) -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <!-- Fecha de Entrega -->
                        <VerticalStackLayout Spacing="6" Grid.Column="0">
                            <Label Text="Fecha de Entrega" FontSize="14" FontAttributes="Bold" TextColor="#5D4037" Margin="4,0,0,0" />
                            <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="50" Padding="12,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <DatePicker MinimumDate="{Binding FechaMinima}" 
                                            Date="{Binding FechaEntrega, Mode=TwoWay}" 
                                            Format="dd/MM/yyyy" 
                                            TextColor="#3E2723" 
                                            BackgroundColor="Transparent" 
                                            VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Hora de Entrega (TimePicker) -->
                        <VerticalStackLayout Spacing="6" Grid.Column="1">
                            <Label Text="Hora de Entrega" FontSize="14" FontAttributes="Bold" TextColor="#5D4037" Margin="4,0,0,0" />
                            <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="50" Padding="12,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <TimePicker Time="{Binding HoraEntrega, Mode=TwoWay}" 
                                            Format="hh:mm tt" 
                                            TextColor="#3E2723" 
                                            BackgroundColor="Transparent" 
                                            VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Modalidad de Entrega (Picker) -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Modalidad de Entrega" FontSize="14" FontAttributes="Bold" TextColor="#5D4037" Margin="4,0,0,0" />
                        <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="50" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Picker Title="Selecciona la modalidad" 
                                    ItemsSource="{Binding ModalidadesEntrega}" 
                                    SelectedItem="{Binding ModalidadSeleccionada, Mode=TwoWay}" 
                                    BackgroundColor="Transparent" 
                                    TextColor="#3E2723" 
                                    TitleColor="#BCAAA4" 
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Campo Condicional: Dirección de Entrega -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding EsEnvioADomicilio}">
                        <Label Text="📍 Dirección Completa de Entrega" FontSize="14" FontAttributes="Bold" TextColor="#5D4037" Margin="4,0,0,0" />
                        <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="50" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Entry Placeholder="Calle, Número, Colonia, Código Postal..." 
                                   Text="{Binding Direccion, Mode=TwoWay}" 
                                   BackgroundColor="Transparent" 
                                   TextColor="#3E2723" 
                                   PlaceholderColor="#BCAAA4" 
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Costo adicional de envío a domicilio: $50.00 MXN" 
                               FontSize="11" 
                               TextColor="#8D6E63" 
                               Margin="4,0,0,0" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#EAE4DB" Margin="0,5" />

                    <!-- Desglose Económico -->
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Subtotal:" FontSize="13" TextColor="#795548" />
                            <Label Grid.Column="1" Text="{Binding SubtotalFormateado}" FontSize="13" TextColor="#5D4037" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Costo de Envío:" FontSize="13" TextColor="#795548" />
                            <Label Grid.Column="1" Text="{Binding CostoEnvioFormateado}" FontSize="13" TextColor="#5D4037" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <Label Grid.Column="0" Text="Total a Pagar:" FontSize="16" FontAttributes="Bold" TextColor="#3E2723" />
                            <Label Grid.Column="1" Text="{Binding TotalFormateado}" FontSize="18" FontAttributes="Bold" TextColor="#8B5E34" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- BOTÓN DE CONFIRMACIÓN -->
            <Button Text="🍰 Confirmar y Generar Orden" 
                    Command="{Binding ConfirmarPedidoCommand}"
                    Margin="0,10,0,0" 
                    HeightRequest="56"
                    CornerRadius="16"
                    BackgroundColor="#8B5E34"
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    FontSize="16">
                <Button.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,6" Opacity="0.25" Radius="12" />
                </Button.Shadow>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
