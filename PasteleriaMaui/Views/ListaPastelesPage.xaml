<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasteleriaMaui.Views.ListaPastelesPage"
             Title="Lista de Pasteles"
             BackgroundColor="#F7F4EF"> <!-- Fondo general beige claro -->

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- Header: Búsqueda + Hero Personalizar + Chips de Categorías -->
        <VerticalStackLayout Padding="20,16,20,10" Spacing="10" Grid.Row="0">
            <Border Stroke="{StaticResource BorderSand}" 
                    StrokeThickness="1" 
                    BackgroundColor="{StaticResource SurfaceWhite}" 
                    HeightRequest="48"
                    Padding="5,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <SearchBar Text="{Binding SearchText}"
                           Placeholder="Buscar pastel o postre..." 
                           CancelButtonColor="{StaticResource DolceRose}" 
                           BackgroundColor="Transparent"
                           TextColor="{StaticResource DarkCocoa}"
                           PlaceholderColor="{StaticResource PlaceholderCocoa}"
                           VerticalOptions="Center"/>
            </Border>

            <!-- Hero Banner Dolce Vita -->
            <Button Text="Arma tu Pastel Personalizado en Vivo"
                    Clicked="OnCrearPersonalizadoClicked"
                    BackgroundColor="{StaticResource DolceRose}"
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    FontSize="14"
                    HeightRequest="46"
                    CornerRadius="14" />

            <!-- Filtro por Categorías (Chips horizontales) -->
            <CollectionView ItemsSource="{Binding Categorias}"
                            SelectedItem="{Binding CategoriaSeleccionada}"
                            SelectionMode="Single"
                            HeightRequest="44"
                            Margin="0,10,0,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="{StaticResource BorderSand}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource SurfaceWhite}"
                                Padding="16,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Label Text="{Binding categoria}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource DarkCocoa}"
                                   VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <!-- Lista de Pasteles en Grid de 4 tarjetas cuadradas por línea -->
        <CollectionView ItemsSource="{Binding Pasteles}" Grid.Row="1" Margin="20,5,20,0">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="4" HorizontalItemSpacing="14" VerticalItemSpacing="14" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="30" Spacing="10">
                    <Label Text="🍰" FontSize="42" HorizontalOptions="Center" />
                    <Label Text="Próximamente más productos en esta sección"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#795548"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    
                    <!-- Tarjeta cuadrada de cada Pastel -->
                    <Border Style="{StaticResource CardBorder}" Padding="12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerDetalleCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Border StrokeThickness="0" BackgroundColor="{StaticResource SurfaceSoft}" HeightRequest="150">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Grid>
                                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                        <Label Text="🎂" FontSize="32" HorizontalOptions="Center" />
                                        <Label Text="Sin foto" FontSize="11" TextColor="{StaticResource PlaceholderCocoa}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                    <Image Source="{Binding FotoUrl}" Aspect="AspectFill" HeightRequest="150" />
                                </Grid>
                            </Border>

                            <Label Text="{Binding Nombre}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource DarkCocoa}" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding PrecioBaseFormateado}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource DolceGold}" />

                            <Button Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.BotonAccionTexto}" 
                                    HeightRequest="38" BackgroundColor="{StaticResource DolceRose}" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="13" CornerRadius="10"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerDetalleCommand}" 
                                    CommandParameter="{Binding .}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Botón Inferior para Administradores -->
        <Button Grid.Row="2" 
                x:Name="BtnRegistrarPastel"
                Text="+ Registrar Nuevo Pastel" 
                Command="{Binding RegistrarNuevoCommand}"
                IsVisible="{Binding IsAdmin}"
                Margin="20,10,20,20"
                HeightRequest="54"
                CornerRadius="27"
                BackgroundColor="#8B5E34"
                TextColor="#FFFFFF"
                FontAttributes="Bold"
                FontSize="16">
            <Button.Shadow>
                <Shadow Brush="#8B5E34" Offset="0,6" Opacity="0.2" Radius="10" />
            </Button.Shadow>
        </Button>
        
    </Grid>

</ContentPage>
