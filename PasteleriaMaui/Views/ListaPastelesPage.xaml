<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasteleriaMaui.Views.ListaPastelesPage"
             Title="Lista de Pasteles"
             BackgroundColor="#F7F4EF"> <!-- Fondo general beige claro -->

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- Barra de Búsqueda -->
        <VerticalStackLayout Padding="20,20,20,10" Grid.Row="0">
            <Border Stroke="#EAE4DB" 
                    StrokeThickness="1" 
                    BackgroundColor="#FFFFFF" 
                    HeightRequest="50"
                    Padding="5,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <SearchBar Placeholder="Buscar pastel..." 
                           CancelButtonColor="#8B5E34" 
                           BackgroundColor="Transparent"
                           TextColor="#3E2723"
                           PlaceholderColor="#A1887F"
                           VerticalOptions="Center"/>
            </Border>
        </VerticalStackLayout>

        <!-- Lista de Pasteles (Bindings intactos) -->
        <CollectionView ItemsSource="{Binding Pasteles}" Grid.Row="1" Margin="20,5,20,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    
                    <!-- Tarjeta de cada Pastel -->
                    <Border Stroke="#EAE4DB" 
                            StrokeThickness="1" 
                            BackgroundColor="#FFFFFF" 
                            Padding="20"
                            Margin="0,0,0,15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#8B5E34" Offset="0,4" Radius="12" Opacity="0.06" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="90, *, Auto" ColumnSpacing="15" VerticalOptions="Center">
                            
                            <!-- Imagen del Pastel -->
                            <Border Grid.Column="0" 
                                    StrokeThickness="0"
                                    BackgroundColor="#FAF8F5"
                                    HeightRequest="90" 
                                    WidthRequest="90">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#8B5E34" Offset="0,2" Radius="6" Opacity="0.08" />
                                </Border.Shadow>
                                <Grid>
                                    <!-- Placeholder (siempre visible detrás) -->
                                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                        <Label Text="🎂" FontSize="28" HorizontalOptions="Center" />
                                        <Label Text="Sin foto" FontSize="10" TextColor="#BCAAA4" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                    <!-- Imagen real (se superpone si carga bien) -->
                                    <Image Source="{Binding FotoUrl}" 
                                           Aspect="AspectFill" 
                                           HeightRequest="90" 
                                           WidthRequest="90" />
                                    <!-- Botón Expandir ⇱ -->
                                    <Border BackgroundColor="#CC8B5E34" 
                                            StrokeThickness="0"
                                            HeightRequest="26" 
                                            WidthRequest="26" 
                                            HorizontalOptions="End" 
                                            VerticalOptions="Start" 
                                            Margin="0,4,4,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="7" />
                                        </Border.StrokeShape>
                                        <Label Text="⇱" 
                                               FontSize="14" 
                                               TextColor="White" 
                                               HorizontalOptions="Center" 
                                               VerticalOptions="Center" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnExpandImageTapped" CommandParameter="{Binding FotoUrl}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Información del Pastel -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding Nombre}" 
                                       FontSize="17" 
                                       FontAttributes="Bold"
                                       TextColor="#3E2723"
                                       LineBreakMode="TailTruncation" />
                                       
                                <Label Text="{Binding Tamanio, StringFormat='Tamaño: {0}'}" 
                                       FontSize="13" 
                                       TextColor="#795548" />
                                       
                                <Label Text="{Binding Bizcocho.Nombre, StringFormat='Bizcocho: {0}'}" 
                                       FontSize="13" 
                                       TextColor="#A1887F" />
                                       
                                <Label Text="{Binding Relleno.Nombre, StringFormat='Relleno: {0}'}" 
                                       FontSize="13" 
                                       TextColor="#A1887F" />
                            </VerticalStackLayout>

                            <!-- Botón de Acción -->
                            <Button Grid.Column="2" 
                                    Text="Pedir ya" 
                                    HeightRequest="40" 
                                    Padding="20,0" 
                                    BackgroundColor="#8B5E34" 
                                    TextColor="#FFFFFF"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    CornerRadius="20"
                                    VerticalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerDetalleCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Botón Inferior para Administradores -->
        <Button Grid.Row="2" 
                x:Name="BtnRegistrarPastel"
                Text="+ Registrar Nuevo Pastel" 
                Command="{Binding RegistrarNuevoCommand}"
                IsVisible="{Binding IsAdmin}"
                Margin="20,10,20,20"
                HeightRequest="54"
                CornerRadius="27"
                BackgroundColor="#8B5E34"
                TextColor="#FFFFFF"
                FontAttributes="Bold"
                FontSize="16">
            <Button.Shadow>
                <Shadow Brush="#8B5E34" Offset="0,6" Opacity="0.2" Radius="10" />
            </Button.Shadow>
        </Button>
        
    </Grid>

</ContentPage>